<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GESMujer | Plataforma Ciudadana de Transparencia e Indicadores de Género</title>
    <script>
        (function() {
            try {
                var guardada = sessionStorage.getItem('plataforma_vista_activa');
                var adminActivo = sessionStorage.getItem('plataforma_admin_sesion_activa');
                var hash = window.location.hash;
                if (adminActivo === 'true' || guardada || (hash && (hash === '#nacional' || hash === '#estatal' || hash === '#admin' || hash.indexOf('#tema-') === 0))) {
                    document.documentElement.classList.add('recarga-modal-activa');
                }
            } catch(e) {}
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,500;0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
