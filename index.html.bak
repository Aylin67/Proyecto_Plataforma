                        <div class="modal-nacional-icon">
                            <i class="fa-solid fa-earth-americas"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-white" id="modalNacionalLabel">
                               POBLACION TOTAL EN MÉXICO
                            </h5>
                            <small class="text-white-50"> INEGI   </small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body modal-nacional-body">
                    <div class="row g-4 align-items-stretch">
                        
                        <div class="col-12 col-xl-7 col-lg-6">
