    <div class="modal" id="modalTematico" tabindex="-1" aria-labelledby="modalTematicoLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content border-0">
                
                <div class="modal-header modal-nacional-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-nacional-icon" id="modalTematicoIconoWrapper">
                            <i class="fa-solid fa-heart-pulse" id="modalTematicoIcono"></i>
                        </div>
