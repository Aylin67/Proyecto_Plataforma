                        <!-- 1. POBLACIÓN HABLANTE DE LENGUA INDÍGENA QUE NO HABLA ESPAÑOL (CENSOS 2010 Y 2020) -->
                        <div class="row g-4 align-items-stretch mb-4">
                            <!-- DIVISIÓN 1: GRÁFICA -->
