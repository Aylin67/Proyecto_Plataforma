                    <!-- ========================================== -->
                    <!-- WORKSPACE PRINCIPAL (DERECHA) -->
                    <!-- ========================================== -->
                    <main class="admin-workspace">
                        
                        <!-- Topbar del Workspace -->
                        <header class="admin-workspace-topbar">
                            <div>
                                <h4 class="admin-topbar-title mb-0" id="adminWorkspaceTitle">
                                    Dashboard User Admin Panel
                                </h4>
                                <div class="admin-topbar-subtitle" id="adminWorkspaceSubtitle">
                                    Sincronización en tiempo real para Mapas Geoespaciales, Gráficas y Métricas
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="admin-topbar-quick-actions d-flex align-items-center gap-2">
                                    <button type="button" class="btn-topbar-action" onclick="AdminDatosUI.deshacerCambioPrevio()" title="Deshacer último cambio">
                                        <i class="fa-solid fa-rotate-left"></i> Deshacer
                                    </button>
                                    <button type="button" class="btn-topbar-action" onclick="AdminDatos.exportarJSON()" title="Respaldar en JSON">
                                        <i class="fa-solid fa-download"></i> Respaldar
                                    </button>
                                    <button type="button" class="btn-topbar-action btn-topbar-reset" onclick="AdminDatosUI.solicitarRestablecer()" title="Restablecer datos INEGI">
                                        <i class="fa-solid fa-arrows-rotate"></i> Restablecer
                                    </button>
                                </div>
                                <span class="d-none" id="adminLiveBadge"></span>
                                <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Cerrar" title="Cerrar panel" onclick="sessionStorage.removeItem('plataforma_admin_sesion_activa'); sessionStorage.removeItem('plataforma_admin_categoria');"></button>
                            </div>
                        </header>

                        <!-- Notificación Toast Flotante Auto-Ocultable (3 segundos) -->
                        <div id="adminToastAuto" class="admin-toast-flotante d-none">
                            <i class="fa-solid fa-circle-check text-success fs-4"></i>
                            <span id="adminToastAutoTexto">¡Cambios guardados con éxito!</span>
                        </div>

                        <!-- Cuadro de Confirmación Elegante para Restablecer -->
                        <div id="adminConfirmBanner" class="admin-confirm-banner d-none mx-4 mt-3">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 44px; height: 44px; background: #fff3e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #e65100; font-size: 1.3rem; flex-shrink: 0;">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>
                                <div>
                                    <strong class="text-dark d-block">¿Deseas restablecer los datos al Censo Oficial INEGI 2020?</strong>
                                    <span class="small text-muted">Esta acción sustituirá las modificaciones por los datos originales de fábrica.</span>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="AdminDatosUI.cancelarRestablecer()">
                                    Cancelar
                                </button>
                                <button type="button" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold" onclick="AdminDatosUI.confirmarRestablecer()">
                                    <i class="fa-solid fa-arrows-rotate me-1"></i> Sí, Restablecer
                                </button>
                            </div>
                        </div>

