    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="assets/js/mexico_estados.js"></script>
    <script src="assets/js/tarjetas.js"></script>
    <script src="assets/js/admin_datos.js"></script>
    <link rel="stylesheet" href="assets/css/estilos.css">

    <!-- ESTILOS PARA LAS TARJETAS MINI SUPERIORES (BARRA STICKY) -->
    <style>
        #contenedorTarjetasModal {
            width: 100%;
            scrollbar-width: thin;
            scrollbar-color: #c2185b #f1f1f1;
        }
        #contenedorTarjetasModal::-webkit-scrollbar { height: 4px; }
        #contenedorTarjetasModal::-webkit-scrollbar-thumb { background: #c2185b; border-radius: 10px; }
        .tema-card-mini {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            min-width: 65px; padding: 4px 6px; border-radius: 10px; cursor: pointer;
            transition: all 0.2s ease; background: #f8f9fa; border: 1px solid #e2e8f0; flex-shrink: 0;
        }
        .tema-card-mini:hover { background: #f3e8f1; border-color: #c2185b; transform: translateY(-2px); }
        .tema-card-mini.active { background: #f3e8f1; border-color: #c2185b; box-shadow: 0 2px 8px rgba(194, 24, 91, 0.25); }
        .tema-card-mini .tema-icon-wrapper { width: 28px !important; height: 28px !important; font-size: 0.75rem !important; margin-bottom: 2px; border-radius: 8px; }
        .tema-nombre-mini { font-size: 0.58rem; font-weight: 700; color: #4a154b; text-align: center; line-height: 1.1; white-space: nowrap; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-ges sticky-top">
    <div class="container">
        <div class="navbar-brand-container d-flex align-items-center justify-content-between w-100">
            <div class="logo-ges-wrapper-izq">
                <img src="assets/img/lo.png" alt="GESMujer emblema" class="navbar-logo-emblema" style="cursor: pointer;" onclick="AdminDatosUI.solicitarAccesoAdmin()" title="GESMujer">
            </div>
            <div class="brand-text-block text-center">
                <span class="brand-titulo-superior">TRANSPARENCIA E INDICADORES PÚBLICOS</span>
            </div>
            <div class="logo-ges-wrapper-der">
                <img src="assets/img/logo.png" alt="GESMujer Rosario Castellanos" class="navbar-logo-texto">
            </div>
        </div>
    </div>
</nav>
    <header class="header-atlas py-5 text-center">
         <div class="emblema-ges mx-auto mb-3" style="cursor: pointer;" onclick="AdminDatosUI.solicitarAccesoAdmin()" title="GESMujer">
            <div class="emblema-interior">
                <i class="fa-solid fa-chart-line emblema-icono"></i>
                <span class="emblema-siglas">GES</span> 
                <span class="emblema-sub">MUJER</span>
            </div>
        </div>
        <div class="container">
<h1 class="titulo-atlas-naranja">¿Quiénes Somos?</h1>
<p class="descripcion-GES-oaxaca mx-auto ">El <strong>
    Grupo de Estudios sobre la Mujer "Rosario Castellanos" A.C.</strong>
    Es una organización feminista fundada en 1977 en Oaxaca de Juárez. 
    Durante más de 45 años hemos acompañado a niñas,
    jóvenes y mujeres en la defensa de sus derechos humanos,
    ofreciendo atención psicológica,asesoría jurídica
    y acompañamiento comunitario en las 8 regiones del estado.
    Trabajamos por una sociedad libre de violencia,
    con igualdad sustantiva y con las mujeres en el centro de la toma de decisiones.</p>

            <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mt-5">
                <button class="btn btn-territorial btn-nacional" id="btnNacional" onclick="cambiarAmbito('NACIONAL', this)">
                    <i class="fa-solid fa-earth-americas me-1"></i> NACIONAL
                </button>
                <button class="btn btn-territorial btn-estatal " id="btnEstatal" onclick="cambiarAmbito('ESTATAL', this)">
                    <i class="fa-solid fa-location-dot me-1"></i> ESTATAL
                </button>
            </div>
        </div>
    </header>
    <div class="cenefa-oaxaca"></div>
    <main class="container">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: var(--ges-naranja-alerta); font-size: 1.50rem;">
            SELECCIONA UNA DIMENSIÓN PARA EXPLORAR SUS INDICADORES EN GRÁFICAS 

            </h2>
            <p class="text-muted small mx-auto" style="max-width: 1100px; text-align: justify;">
            Esta sección reúne información estadística sobre salud, 
            educación, vivienda, ingresos en Oaxaca,así como datos sobre
            las atenciones psicológicas y jurídicas,talleres,femicidios, proyectos 
            y otras acciones realizadas por GESMujer Rosario Castellanos. Mediante gráficas facilita la
            consulta y comprensión de información relevante sobre las 
            condiciones de vida de la población y las actividades
            de la organización, contribuyendo a la difusión de información de interés público.
          </p>
        </div>

<div class="row g-3 justify-content-center mb-5" id="contenedorTarjetas">

    <div class="col-6 col-sm-4 col-md-3 col-lg-2 item-fuente-cisges">
