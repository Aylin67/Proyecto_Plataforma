                                <div class="card modal-nacional-card h-100">
                                    <div class="row g-2 mb-3">
                                        <div class="col-12">
                                            <div class="card-metrica-total">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="small text-uppercase fw-bold opacity-75">
                                                        <i class="fa-solid fa-user-clock me-1"></i> TOTAL DE LA TASA DE DESOCUPACIÓN 
                                                    </div>
                                                </div>
                                                <div class="fs-2 fw-bold my-1">20.24%</div>
                                                
                                            </div>
