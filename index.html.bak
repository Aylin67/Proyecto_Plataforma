                                    </i> Mapa de la  República Mexicana </i>
                                    </h6>
                                   
                                </div>
                                <p class="small text-muted mb-2">
                                  Haz clic para consultar sus indicadores demográficos.
                                </p>
                                
                                <div id="mapaMexico"></div>
                                <div class="mapa-mexico-leyenda">
                                    <span><i class="fa-solid fa-square me-1" style="color: #682260;"></i> Mapa de la República Mexicana</span>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <div class="small fw-bold text-muted mb-2"><i class="fa-solid fa-arrows-left-right me-1"></i> Cambiar vista territorial:</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm rounded-pill px-3 fw-bold" style="background:#f3e8f1;color:#4a154b;border:1px solid #682260;" onclick="bootstrap.Modal.getInstance(document.getElementById('modalNacional'))?.hide(); setTimeout(()=>cambiarAmbito('ESTATAL',null),300);">
                                            <i class="fa-solid fa-location-dot me-1"></i> Estatal
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xl-5 col-lg-6">
                            <div class="card modal-nacional-card">

                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <div class="modal-nacional-icon" style="width:36px;height:36px;font-size:1rem;" id="iconoPanelNacional">
                                        <i class="fa-solid fa-earth-americas"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="color:#4a154b;font-size:1.05rem;" id="tituloPanelNacional">POBLACIÓN TOTAL EN MÉXICO</div>
                                        <div class="small text-muted" id="subtituloPanelNacional">Haz clic en un estado para ver sus datos</div>
                                    </div>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-12">
                                        <div class="card-metrica-total">
                                            <div class="small text-uppercase fw-bold opacity-75">
                                                <i class="fa-solid fa-users me-1"></i> <span id="labelNacionalTotal">Población Total </span>
                                            </div>
                                            <div class="fs-2 fw-bold my-1" id="kpiNacionalTotal">126,014,024</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card-metrica-mujeres">
                                            <div class="small text-uppercase fw-bold text-danger">
                                                <i class="fa-solid fa-venus me-1"></i> Mujeres
                                            </div>
                                            <div class="fs-4 fw-bold text-danger my-1" id="kpiNacionalMujeres">64,540,634</div>
                                            <div class="badge bg-danger px-2 py-1 rounded-pill" id="kpiNacionalPctMujeres">51.22% del total</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card-metrica-hombres">
                                            <div class="small text-uppercase fw-bold" style="color: #00897b;">
                                                <i class="fa-solid fa-mars me-1"></i> Hombres
                                            </div>
                                            <div class="fs-4 fw-bold my-1" style="color: #00897b;" id="kpiNacionalHombres">61,473,390</div>
                                            <div class="badge px-2 py-1 rounded-pill text-white" style="background: #00897b;" id="kpiNacionalPctHombres">48.78% del total</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="grafica-barras-contenedor">
                                    <canvas id="canvasNacional"></canvas>
                                </div>

                                <div class="mt-2 text-center" id="btnVolverMexicoWrap" style="display:none;">
                                    <button class="btn btn-sm rounded-pill px-3 fw-bold" style="background:#f3e8f1;color:#4a154b;border:1px solid #682260;" onclick="mostrarDatosMexicoNacional()">
                                        <i class="fa-solid fa-earth-americas me-1"></i> Ver datos de México
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-white px-4 py-3 border-top d-flex justify-content-end align-items-center">
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" data-bs-dismiss="modal">
                        Cerrar <i class="fa-solid fa-arrow-down ms-1"></i>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEstatal" tabindex="-1" aria-labelledby="modalEstatalLabel" aria-hidden="true">
