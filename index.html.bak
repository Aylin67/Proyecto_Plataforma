    <!-- ======================================================== -->
    <!-- SCRIPT CONTROLADOR DEL DASHBOARD SAAS (SIDEBAR & CAMPOS) -->
    <!-- ======================================================== -->
    <script>
        const AdminMenuDashboard = {
            categoriaActiva: 'inicio',

            metaCategorias: {
                inicio: {
                    label: '<i class="fa-solid fa-house me-2"></i>INICIO',
                    clase: 'recuadro-nacional',
                    titulo: 'Panel del Administrador',
                    kpi1: { label: 'Categorías Totales', sub: 'Módulos disponibles' },
                    kpi2: { label: 'Sesión Activa', sub: 'Soledad Venegas' },
                    kpi3: { label: 'Estado del Sistema', sub: 'Sincronizado' }
                },
                nacional: {
                    label: '<i class="fa-solid fa-earth-americas me-2"></i>NIVEL NACIONAL',
                    clase: 'recuadro-nacional',
                    titulo: 'Nivel Nacional (México)',
                    kpi1: { label: 'Población Total Registrada', sub: 'Censo Oficial INEGI' },
                    kpi2: { label: 'Mujeres en el País', sub: 'Cálculo porcentual automático' },
                    kpi3: { label: 'Hombres en el País', sub: 'Cálculo porcentual automático' }
                },
                estatal: {
                    label: '<i class="fa-solid fa-location-dot me-2"></i>NIVEL ESTATAL (OAXACA)',
                    clase: 'recuadro-estatal',
                    titulo: 'Nivel Estatal (Oaxaca)',
                    kpi1: { label: 'Población Total Oaxaca', sub: 'Censo Oficial INEGI' },
                    kpi2: { label: 'Mujeres en Oaxaca', sub: 'Cálculo porcentual automático' },
                    kpi3: { label: 'Hombres en Oaxaca', sub: 'Cálculo porcentual automático' }
                },
                regional: {
                    label: '<i class="fa-solid fa-map me-2"></i>NIVEL REGIONAL (REGIONES)',
                    clase: 'recuadro-regional',
                    titulo: 'Nivel Regional ',
                    kpi1: { label: 'Población de la Región', sub: 'Censo Oficial INEGI' },
                    kpi2: { label: 'Mujeres en la Región', sub: 'Cálculo porcentual automático' },
                    kpi3: { label: 'Hombres en la Región', sub: 'Cálculo porcentual automático' }
                },
                salud: {
                    label: '<i class="fa-solid fa-heart-pulse me-2"></i>SALUD Y MORBILIDAD',
                    clase: 'recuadro-salud',
                    titulo: 'Salud Mujeres y Niñas (Oaxaca)',
                    kpi1: { label: 'Defunciones Mujeres', sub: 'Principales patologías ' },
                    kpi2: { label: 'Defunciones Niñas', sub: 'Mortalidad y patologías ' },
                    kpi3: { label: 'Causa con Mayor Incidencia', sub: 'Cardiovascular y Infecciones' }
                },
                educacion: {
                    label: '<i class="fa-solid fa-graduation-cap me-2"></i>EDUCACIÓN Y STEM',
                    clase: 'recuadro-educacion',
                    titulo: 'Educación Académica (Oaxaca)',
                    kpi1: { label: 'Mujeres Nivel Avanzado', sub: 'Bachillerato, Lic. y Posgrado' },
                    kpi2: { label: 'Fuera de la Escuela', sub: 'Causas estructurales' },
                    kpi3: { label: 'Niñas Asistiendo', sub: 'Permanencia escolar primaria' }
                },
                vivienda: {
                    label: '<i class="fa-solid fa-house-chimney me-2"></i>VIVIENDA Y SERVICIOS',
                    clase: 'recuadro-vivienda',
                    titulo: 'Vivienda y Servicios Básicos ',
                    kpi1: { label: 'Viviendas Particulares', sub: 'Censo Oficial INEGI' },
                    kpi2: { label: 'Vivienda Propia Mujeres', sub: 'Patrimonio femenino' },
                    kpi3: { label: 'Acceso a Electricidad', sub: 'Servicio con mayor cobertura' }
                },
                ingreso: {
                    label: '<i class="fa-solid fa-hand-holding-dollar me-2"></i>INGRESO Y EMPLEO',
                    clase: 'recuadro-ingreso',
                    titulo: 'Ingreso, Empleo y Remesas ',
                    kpi1: { label: 'Mujeres Ocupadas', sub: 'Población económicamente activa' },
                    kpi2: { label: 'Trabajo No Formal / Informal', sub: 'Mayoría ocupacional en Oaxaca' },
                    kpi3: { label: 'Empleo Formal', sub: 'Con contrato y seguridad social' }
                },
                psicologia: {
                    label: '<i class="fa-solid fa-hand-holding-heart me-2"></i>PSICOLOGÍA Y CITAS',
                    clase: 'recuadro-psicologia',
                    titulo: 'Atención y Asesoría Psicológica (CISGES)',
                    kpi1: { label: 'Sesiones Brindadas', sub: 'Atención psicológica y contención' },
                    kpi2: { label: 'Casos en Seguimiento', sub: 'En proceso terapéutico' },
                    kpi3: { label: 'Modalidad Principal', sub: 'Presencial en Sede Oaxaca' }
                },
                juicios: {
                    label: '<i class="fa-solid fa-scale-balanced me-2"></i>JUICIOS Y ASESORÍA LEGAL',
                    clase: 'recuadro-juicios',
                    titulo: 'Juicios y Asesoría Legal (CISGES)',
                    kpi1: { label: 'Servicios Jurídicos', sub: 'Asesorías y litigio familiar' },
                    kpi2: { label: 'Expedientes Activos', sub: 'Trámite judicial en curso' },
                    kpi3: { label: 'Materia Principal', sub: 'Pensión alimenticia y custodia' }
                },
                atendidas: {
                    label: '<i class="fa-solid fa-people-group me-2"></i>USUARIAS ATENDIDAS',
                    clase: 'recuadro-atendidas',
                    titulo: 'Usuarias Atendidas y Acompañamiento (CISGES)',
                    kpi1: { label: 'Mujeres Atendidas', sub: 'Atención integral directa' },
                    kpi2: { label: 'Comunidades y Lengua Indígena', sub: 'Identidad y procedencia rural' },
                    kpi3: { label: 'Violencia Prevalente', sub: 'Psicológica y física' }
                },
                feminicidios: {
                    label: '<i class="fa-solid fa-ribbon me-2"></i>REGISTRO DE FEMINICIDIOS',
                    clase: 'recuadro-feminicidios',
                    titulo: 'Registro Hemerográfico de Feminicidios (Oaxaca)',
                    kpi1: { label: 'Muertes Violentas', sub: 'Registro hemeroteca GESMujer' },
                    kpi2: { label: 'En Municipios con AVG', sub: 'Alerta de Violencia de Género' },
                    kpi3: { label: 'Arma Prevalente', sub: 'Impacto de arma de fuego' }
                },
                talleres: {
                    label: '<i class="fa-solid fa-chalkboard-user me-2"></i>TALLERES Y FORMACIÓN',
                    clase: 'recuadro-talleres',
                    titulo: 'Talleres y Capacitación Comunitaria (CISGES)',
                    kpi1: { label: 'Procesos de Formación', sub: 'Talleres, diplomados y eventos' },
                    kpi2: { label: 'Participantes Convocadas', sub: 'Mujeres comunitarias y jóvenes' },
                    kpi3: { label: 'Acreditación y Asistencia', sub: 'Cumplimiento formativo' }
                },
                proyectos: {
                    label: '<i class="fa-solid fa-diagram-project me-2"></i>PROYECTOS Y FONDOS',
                    clase: 'recuadro-proyectos',
                    titulo: 'Proyectos Institucionales y Donaciones (CISGES)',
                    kpi1: { label: 'Cartera Institucional', sub: 'Proyectos activos y concluidos' },
                    kpi2: { label: 'Fondos en Pesos ($)', sub: 'Cooperación y donaciones' },
                    kpi3: { label: 'Beneficiarias Directas', sub: 'Impacto en comunidades de Oaxaca' }
                }
            },

            formatearNumero(num) {
                if (num === null || num === undefined || isNaN(num)) return '0';
                return Number(num).toLocaleString('es-MX');
            },

            seleccionar(cat) {
                if (!this.metaCategorias[cat]) cat = 'inicio';
                this.categoriaActiva = cat;

                try {
                    sessionStorage.setItem('plataforma_admin_sesion_activa', 'true');
                    sessionStorage.setItem('plataforma_admin_categoria', cat);
                } catch(e) {}

                // 1. Actualizar menú lateral
                document.querySelectorAll('#adminSidebarMenu .admin-menu-btn').forEach(btn => {
                    const esActivo = btn.getAttribute('data-cat') === cat;
                    btn.classList.toggle('active', esActivo);
                });

                // 2. Ocultar todas las vistas y mostrar la elegida
                const vistas = ['inicio', 'nacional', 'estatal', 'regional', 'salud', 'educacion', 'vivienda', 'ingreso', 'psicologia', 'juicios', 'atendidas', 'feminicidios', 'talleres', 'proyectos'];
                vistas.forEach(v => {
                    const el = document.getElementById('adminView_' + v);
                    if (el) el.classList.toggle('d-none', v !== cat);
                });

                // 3. Ocultar / Mostrar KPI Cards y Recuadro según si es Inicio (Espacio en blanco)
                const kpiRow = document.getElementById('adminKpiCardsRow');
                const recuadroWrap = document.getElementById('adminDetalleRecuadro')?.parentElement;
                
                if (kpiRow) kpiRow.classList.toggle('d-none', cat === 'inicio');
                if (recuadroWrap) recuadroWrap.classList.toggle('d-none', cat === 'inicio');

                // CORRECCIÓN: Asegurar que el contenedor de la pantalla de detalle se muestre siempre
                const pantallaDetalle = document.getElementById('adminPantallaDetalle');
                if (pantallaDetalle) {
                    pantallaDetalle.classList.remove('d-none');
                }

                // 4. Actualizar recuadro centrado unificado
                const meta = this.metaCategorias[cat];
                const recuadro = document.getElementById('adminDetalleRecuadro');
                const titulo = document.getElementById('adminDetalleTitulo');
                if (recuadro && meta) {
                    recuadro.className = 'admin-categoria-recuadro ' + meta.clase;
                }
                if (titulo && meta) {
                    titulo.innerHTML = meta.label;
                }

                // 5. Actualizar título y subtítulo del topbar del workspace
                const wTitle = document.getElementById('adminWorkspaceTitle');
                const wSub = document.getElementById('adminWorkspaceSubtitle');
                if (wTitle && meta) wTitle.textContent = meta.titulo;
                if (wSub && meta) wSub.textContent = meta.sub;

                // 6. Conectar con AdminDatosUI si existe
                if (window.AdminDatosUI && typeof window.AdminDatosUI.abrirCategoria === 'function' && cat !== 'inicio') {
                    try {
                        window.AdminDatosUI.abrirCategoria(cat);
                    } catch (e) {
                        console.warn('AdminDatosUI.abrirCategoria aviso:', e);
                    }
                }

                // 7. Actualizar las 3 KPI Cards superiores
                if (cat !== 'inicio') {
                    this.actualizarKpis(cat);
                }

                // 8. Recálculo automático de porcentajes en badges
                if (cat === 'salud') {
                    this.recalcularSalud();
                } else if (cat === 'educacion') {
                    this.recalcularEducacion();
                } else if (cat === 'vivienda') {
                    this.recalcularVivienda();
                } else if (cat === 'ingreso') {
                    this.recalcularIngreso();
                } else if (cat === 'psicologia') {
                    this.recalcularPsicologia();
                } else if (cat === 'juicios') {
                    this.recalcularJuicios();
                } else if (cat === 'atendidas') {
                    this.recalcularAtendidas();
                } else if (cat === 'feminicidios') {
                    this.recalcularFeminicidios();
                } else if (cat === 'talleres') {
                    this.recalcularTalleres();
                } else if (cat === 'proyectos') {
                    this.recalcularProyectos();
                }
            },

            actualizarKpis(cat) {
                const meta = this.metaCategorias[cat];
                if (!meta) return;

                const t1 = document.getElementById('kpiCard1Title');
                const s1 = document.getElementById('kpiCard1Sub');
                const v1 = document.getElementById('kpiCard1Val');

                const t2 = document.getElementById('kpiCard2Title');
                const s2 = document.getElementById('kpiCard2Sub');
                const v2 = document.getElementById('kpiCard2Val');
                const b2 = document.getElementById('kpiCard2Badge');

                const t3 = document.getElementById('kpiCard3Title');
                const s3 = document.getElementById('kpiCard3Sub');
                const v3 = document.getElementById('kpiCard3Val');
                const b3 = document.getElementById('kpiCard3Badge');

                if (t1) t1.textContent = meta.kpi1.label;
                if (s1) s1.textContent = meta.kpi1.sub;
                if (t2) t2.textContent = meta.kpi2.label;
                if (s2) s2.textContent = meta.kpi2.sub;
                if (t3) t3.textContent = meta.kpi3.label;
                if (s3) s3.textContent = meta.kpi3.sub;

                if (cat === 'nacional') {
                    const pob = parseFloat(document.getElementById('inputNacPob')?.value) || 126014024;
                    const muj = parseFloat(document.getElementById('inputNacMujeres')?.value) || 64540634;
                    const hom = parseFloat(document.getElementById('inputNacHombres')?.value) || 61473390;
                    const pM = pob > 0 ? ((muj / pob) * 100).toFixed(1) + '%' : '0%';
                    const pH = pob > 0 ? ((hom / pob) * 100).toFixed(1) + '%' : '0%';
                    if (v1) v1.textContent = this.formatearNumero(pob);
                    if (v2) v2.textContent = this.formatearNumero(muj);
                    if (b2) b2.textContent = pM;
                    if (v3) v3.textContent = this.formatearNumero(hom);
                    if (b3) b3.textContent = pH;
                } else if (cat === 'estatal') {
                    const pob = parseFloat(document.getElementById('inputEstPob')?.value) || 4132148;
                    const muj = parseFloat(document.getElementById('inputEstMujeres')?.value) || 2157305;
                    const hom = parseFloat(document.getElementById('inputEstHombres')?.value) || 1974843;
                    const pM = pob > 0 ? ((muj / pob) * 100).toFixed(1) + '%' : '0%';
                    const pH = pob > 0 ? ((hom / pob) * 100).toFixed(1) + '%' : '0%';
                    if (v1) v1.textContent = this.formatearNumero(pob);
                    if (v2) v2.textContent = this.formatearNumero(muj);
                    if (b2) b2.textContent = pM;
                    if (v3) v3.textContent = this.formatearNumero(hom);
                    if (b3) b3.textContent = pH;
                } else if (cat === 'regional') {
                    const pob = parseFloat(document.getElementById('inputRegPob')?.value) || 1033884;
                    const muj = parseFloat(document.getElementById('inputRegMujeres')?.value) || 549000;
                    const hom = parseFloat(document.getElementById('inputRegHombres')?.value) || 484884;
                    const pM = pob > 0 ? ((muj / pob) * 100).toFixed(1) + '%' : '0%';
                    const pH = pob > 0 ? ((hom / pob) * 100).toFixed(1) + '%' : '0%';
                    if (v1) v1.textContent = this.formatearNumero(pob);
                    if (v2) v2.textContent = this.formatearNumero(muj);
                    if (b2) b2.textContent = pM;
                    if (v3) v3.textContent = this.formatearNumero(hom);
                    if (b3) b3.textContent = pH;
                } else if (cat === 'salud') {
                    const totM = (parseFloat(document.getElementById('numSalud_cancerMama')?.value) || 1050)
                               + (parseFloat(document.getElementById('numSalud_cancerCerv')?.value) || 250)
                               + (parseFloat(document.getElementById('numSalud_cancerColo')?.value) || 380)
                               + (parseFloat(document.getElementById('numSalud_cancerPulmon')?.value) || 265)
                               + (parseFloat(document.getElementById('numSalud_cancerTiroides')?.value) || 148)
                               + (parseFloat(document.getElementById('numSalud_externaAccidentes')?.value) || 331)
                               + (parseFloat(document.getElementById('numSalud_externaHomicidio')?.value) || 173)
                               + (parseFloat(document.getElementById('numSalud_externaSuicidio')?.value) || 109)
                               + (parseFloat(document.getElementById('numSalud_embarazo')?.value) || 131)
                               + (parseFloat(document.getElementById('numSalud_parto')?.value) || 96)
                               + (parseFloat(document.getElementById('numSalud_puerperio')?.value) || 77)
                               + (parseFloat(document.getElementById('numSalud_diabTipo1')?.value) || 76)
                               + (parseFloat(document.getElementById('numSalud_diabTipo2')?.value) || 1097)
                               + (parseFloat(document.getElementById('numSalud_diabGest')?.value) || 119)
                               + (parseFloat(document.getElementById('numSalud_diabMody')?.value) || 38)
                               + (parseFloat(document.getElementById('numSalud_diabLada')?.value) || 82)
                               + (parseFloat(document.getElementById('numSalud_diabInsipida')?.value) || 23)
                               + (parseFloat(document.getElementById('numSalud_diabSec')?.value) || 127)
                               + (parseFloat(document.getElementById('numSalud_hipertension')?.value) || 787)
                               + (parseFloat(document.getElementById('numSalud_infartos')?.value) || 1015)
                               + (parseFloat(document.getElementById('numSalud_insuficiencia')?.value) || 600);

                    const totN = (parseFloat(document.getElementById('numNinas_consInfecciones')?.value) || 584)
                               + (parseFloat(document.getElementById('numNinas_consDesnutricion')?.value) || 573)
                               + (parseFloat(document.getElementById('numNinas_consMortalidadMenor1')?.value) || 432)
                               + (parseFloat(document.getElementById('numNinas_consViolencias')?.value) || 362);

                    const cardioTot = (parseFloat(document.getElementById('numSalud_hipertension')?.value) || 787)
                                    + (parseFloat(document.getElementById('numSalud_infartos')?.value) || 1015)
                                    + (parseFloat(document.getElementById('numSalud_insuficiencia')?.value) || 600);

                    const pN = (totM + totN) > 0 ? ((totN / (totM + totN)) * 100).toFixed(1) + '%' : '21.9%';
                    const pC = totM > 0 ? ((cardioTot / totM) * 100).toFixed(1) + '%' : '34.4%';

                    if (v1) v1.textContent = this.formatearNumero(totM) + ' defunciones';
                    if (v2) v2.textContent = this.formatearNumero(totN) + ' defunciones';
                    if (b2) b2.textContent = pN;
                    if (v3) v3.textContent = this.formatearNumero(cardioTot) + ' Cardio';
                    if (b3) b3.textContent = pC;
                } else if (cat === 'educacion') {
                    const b = parseFloat(document.getElementById('numEdu_bachillerato')?.value) || 207850;
                    const l = parseFloat(document.getElementById('numEdu_licenciatura')?.value) || 139800;
                    const p = parseFloat(document.getElementById('numEdu_posgrado')?.value) || 20100;
                    const totAvanzado = b + l + p;

                    const cui = parseFloat(document.getElementById('numEdu_cuidados')?.value) || 139100;
                    const rec = parseFloat(document.getElementById('numEdu_recursos')?.value) || 111400;
                    const mat = parseFloat(document.getElementById('numEdu_maternidad')?.value) || 76100;
                    const totFuera = cui + rec + mat;

                    const nInsc = parseFloat(document.getElementById('numEduNinas_inscritas')?.value) || 396250;
                    const nNoAs = parseFloat(document.getElementById('numEduNinas_noAsisten')?.value) || 51570;
                    const nAban = parseFloat(document.getElementById('numEduNinas_abandono')?.value) || 19360;
                    const totNinas = nInsc + nNoAs + nAban;
                    const pInsc = totNinas > 0 ? ((nInsc / totNinas) * 100).toFixed(1) + '%' : '84.8%';

                    if (v1) v1.textContent = this.formatearNumero(totAvanzado) + ' mujeres';
                    if (v2) v2.textContent = this.formatearNumero(totFuera) + ' fuera';
                    if (b2) b2.textContent = totAvanzado > 0 ? ((totFuera / (totAvanzado + totFuera)) * 100).toFixed(1) + '%' : '47.0%';
                    if (v3) v3.textContent = this.formatearNumero(nInsc) + ' niñas';
                    if (b3) b3.textContent = pInsc;
                } else if (cat === 'vivienda') {
                    const pProp = parseFloat(document.getElementById('numViv_propia')?.value) || 335503;
                    const pRent = parseFloat(document.getElementById('numViv_rentan')?.value) || 128347;
                    const pPres = parseFloat(document.getElementById('numViv_prestada')?.value) || 204905;
                    const pEjid = parseFloat(document.getElementById('numViv_ejidal')?.value) || 188016;
                    const totTen = pProp + pRent + pPres + pEjid;
                    const pPropPct = totTen > 0 ? ((pProp / totTen) * 100).toFixed(1) + '%' : '39.2%';

                    const vLuz = parseFloat(document.getElementById('numViv_luz')?.value) || 1096577;
                    const pLuzPct = ((vLuz / 1125849) * 100).toFixed(1) + '%';

                    if (v1) v1.textContent = '1,125,849 viviendas';
                    if (v2) v2.textContent = this.formatearNumero(pProp) + ' propia';
                    if (b2) b2.textContent = pPropPct;
                    if (v3) v3.textContent = this.formatearNumero(vLuz) + ' luz';
                    if (b3) b3.textContent = pLuzPct;
                } else if (cat === 'ingreso') {
                    const f = parseFloat(document.getElementById('numIng_formal')?.value) || 139650;
                    const i = parseFloat(document.getElementById('numIng_informal')?.value) || 603200;
                    const tot = f + i;
                    const pF = tot > 0 ? ((f / tot) * 100).toFixed(1) + '%' : '18.8%';
                    const pI = tot > 0 ? ((i / tot) * 100).toFixed(1) + '%' : '81.2%';

                    if (v1) v1.textContent = this.formatearNumero(tot) + ' ocupadas';
                    if (v2) v2.textContent = this.formatearNumero(i) + ' informal';
                    if (b2) b2.textContent = pI;
                    if (v3) v3.textContent = this.formatearNumero(f) + ' formal';
                    if (b3) b3.textContent = pF;
                } else if (cat === 'psicologia') {
                    const ini = parseFloat(document.getElementById('numPsic_inicial')?.value) || 345;
                    const con = parseFloat(document.getElementById('numPsic_continua')?.value) || 520;
                    const urg = parseFloat(document.getElementById('numPsic_urgencia')?.value) || 180;
                    const can = parseFloat(document.getElementById('numPsic_canalizacion')?.value) || 95;
                    const totSes = ini + con + urg + can;

                    const proc = parseFloat(document.getElementById('numPsic_enProceso')?.value) || 460;
                    const concl = parseFloat(document.getElementById('numPsic_concluidos')?.value) || 390;
                    const plan = parseFloat(document.getElementById('numPsic_planVida')?.value) || 210;
                    const aban = parseFloat(document.getElementById('numPsic_abandono')?.value) || 80;
                    const totCas = proc + concl + plan + aban;
                    const pProc = totCas > 0 ? ((proc / totCas) * 100).toFixed(1) + '%' : '40.4%';

                    const pres = parseFloat(document.getElementById('numPsic_presencial')?.value) || 680;
                    const tel = parseFloat(document.getElementById('numPsic_telefonica')?.value) || 310;
                    const vir = parseFloat(document.getElementById('numPsic_virtual')?.value) || 150;
                    const totMod = pres + tel + vir;
                    const pPres = totMod > 0 ? ((pres / totMod) * 100).toFixed(1) + '%' : '59.6%';

                    if (v1) v1.textContent = this.formatearNumero(totSes) + ' sesiones';
                    if (v2) v2.textContent = this.formatearNumero(proc) + ' casos';
                    if (b2) b2.textContent = pProc;
                    if (v3) v3.textContent = this.formatearNumero(pres) + ' presencial';
                    if (b3) b3.textContent = pPres;
                } else if (cat === 'juicios') {
                    const ase = parseFloat(document.getElementById('numJui_asesorias')?.value) || 280;
                    const aud = parseFloat(document.getElementById('numJui_audiencias')?.value) || 195;
                    const car = parseFloat(document.getElementById('numJui_carpetas')?.value) || 140;
                    const tel = parseFloat(document.getElementById('numJui_telefonicas')?.value) || 85;
                    const totServ = ase + aud + car + tel;

                    const sent = parseFloat(document.getElementById('numJui_sentencia')?.value) || 185;
                    const act = parseFloat(document.getElementById('numJui_activo')?.value) || 310;
                    const conv = parseFloat(document.getElementById('numJui_convenios')?.value) || 130;
                    const conc = parseFloat(document.getElementById('numJui_concluidos')?.value) || 75;
                    const totExp = sent + act + conv + conc;
                    const pAct = totExp > 0 ? ((act / totExp) * 100).toFixed(1) + '%' : '44.3%';

                    const pen = parseFloat(document.getElementById('numJui_pension')?.value) || 260;
                    const cus = parseFloat(document.getElementById('numJui_custodia')?.value) || 210;
                    const div = parseFloat(document.getElementById('numJui_divorcio')?.value) || 145;
                    const ord = parseFloat(document.getElementById('numJui_ordenes')?.value) || 85;
                    const totMat = pen + cus + div + ord;
                    const pPen = totMat > 0 ? ((pen / totMat) * 100).toFixed(1) + '%' : '37.1%';

                    if (v1) v1.textContent = this.formatearNumero(totServ) + ' servicios';
                    if (v2) v2.textContent = this.formatearNumero(act) + ' activos';
                    if (b2) b2.textContent = pAct;
                    if (v3) v3.textContent = this.formatearNumero(pen) + ' pensión alim.';
                    if (b3) b3.textContent = pPen;
                } else if (cat === 'atendidas') {
                    const adu = parseFloat(document.getElementById('numAten_adultas')?.value) || 890;
                    const adl = parseFloat(document.getElementById('numAten_adolescentes')?.value) || 245;
                    const tut = parseFloat(document.getElementById('numAten_tutoras')?.value) || 160;
                    const inf = parseFloat(document.getElementById('numAten_infantes')?.value) || 125;
                    const totUsu = adu + adl + tut + inf;

                    const ind = parseFloat(document.getElementById('numAten_indigenas')?.value) || 430;
                    const noI = parseFloat(document.getElementById('numAten_noIndigenas')?.value) || 865;
                    const totId = ind + noI;
                    const pInd = totId > 0 ? ((ind / totId) * 100).toFixed(1) + '%' : '33.2%';

                    const vPs = parseFloat(document.getElementById('numAten_vPsic')?.value) || 610;
                    const vFi = parseFloat(document.getElementById('numAten_vFis')?.value) || 340;
                    const vEc = parseFloat(document.getElementById('numAten_vEcon')?.value) || 280;
                    const vSe = parseFloat(document.getElementById('numAten_vSex')?.value) || 190;
                    const totVio = vPs + vFi + vEc + vSe;
                    const pVPs = totVio > 0 ? ((vPs / totVio) * 100).toFixed(1) + '%' : '43.0%';

                    if (v1) v1.textContent = this.formatearNumero(totUsu) + ' usuarias';
                    if (v2) v2.textContent = this.formatearNumero(ind) + ' indígenas';
                    if (b2) b2.textContent = pInd;
                    if (v3) v3.textContent = this.formatearNumero(vPs) + ' viol. psic.';
                    if (b3) b3.textContent = pVPs;
                } else if (cat === 'feminicidios') {
                    const ist = parseFloat(document.getElementById('numFem_istmo')?.value) || 38;
                    const val = parseFloat(document.getElementById('numFem_valles')?.value) || 32;
                    const cos = parseFloat(document.getElementById('numFem_costa')?.value) || 29;
                    const sur = parseFloat(document.getElementById('numFem_sierraSur')?.value) || 21;
                    const mix = parseFloat(document.getElementById('numFem_mixteca')?.value) || 14;
                    const otr = parseFloat(document.getElementById('numFem_otrasReg')?.value) || 20;
                    const totFem = ist + val + cos + sur + mix + otr;

                    const cAvg = parseFloat(document.getElementById('numFem_conAvg')?.value) || 92;
                    const sAvg = parseFloat(document.getElementById('numFem_sinAvg')?.value) || 62;
                    const totAvg = cAvg + sAvg;
                    const pAvg = totAvg > 0 ? ((cAvg / totAvg) * 100).toFixed(1) + '%' : '59.7%';

                    const fue = parseFloat(document.getElementById('numFem_armaFuego')?.value) || 96;
                    const bla = parseFloat(document.getElementById('numFem_armaBlanca')?.value) || 28;
                    const fis = parseFloat(document.getElementById('numFem_fuerzaFisica')?.value) || 22;
                    const nes = parseFloat(document.getElementById('numFem_noEspec')?.value) || 8;
                    const totArm = fue + bla + fis + nes;
                    const pArm = totArm > 0 ? ((fue / totArm) * 100).toFixed(1) + '%' : '62.3%';

                    if (v1) v1.textContent = this.formatearNumero(totFem) + ' casos';
                    if (v2) v2.textContent = this.formatearNumero(cAvg) + ' con AVG';
                    if (b2) b2.textContent = pAvg;
                    if (v3) v3.textContent = this.formatearNumero(fue) + ' arma fuego';
                    if (b3) b3.textContent = pArm;
                } else if (cat === 'talleres') {
                    const tal = parseFloat(document.getElementById('numTal_talleres')?.value) || 48;
                    const dip = parseFloat(document.getElementById('numTal_diplomados')?.value) || 12;
                    const sem = parseFloat(document.getElementById('numTal_seminarios')?.value) || 16;
                    const mod = parseFloat(document.getElementById('numTal_modulos')?.value) || 64;
                    const totEve = tal + dip + sem + mod;

                    const com = parseFloat(document.getElementById('numTal_mujeresCom')?.value) || 940;
                    const est = parseFloat(document.getElementById('numTal_estudiantes')?.value) || 520;
                    const fun = parseFloat(document.getElementById('numTal_funcionarias')?.value) || 310;
                    const per = parseFloat(document.getElementById('numTal_personal')?.value) || 110;
                    const totPar = com + est + fun + per;
                    const pCom = totPar > 0 ? ((com / totPar) * 100).toFixed(1) + '%' : '50.0%';

                    const asi = parseFloat(document.getElementById('numTal_asistieron')?.value) || 1580;
                    const prm = parseFloat(document.getElementById('numTal_permisos')?.value) || 180;
                    const baj = parseFloat(document.getElementById('numTal_bajas')?.value) || 120;
                    const totAsi = asi + prm + baj;
                    const pAsi = totAsi > 0 ? ((asi / totAsi) * 100).toFixed(1) + '%' : '84.0%';

                    if (v1) v1.textContent = this.formatearNumero(totEve) + ' procesos';
                    if (v2) v2.textContent = this.formatearNumero(totPar) + ' participantes';
                    if (b2) b2.textContent = pCom;
                    if (v3) v3.textContent = this.formatearNumero(asi) + ' concluyeron';
                    if (b3) b3.textContent = pAsi;
                } else if (cat === 'proyectos') {
                    const act = parseFloat(document.getElementById('numProy_activos')?.value) || 8;
                    const con = parseFloat(document.getElementById('numProy_concluidos')?.value) || 14;
                    const ges = parseFloat(document.getElementById('numProy_gestion')?.value) || 5;
                    const totProy = act + con + ges;

                    const int = parseFloat(document.getElementById('numProy_internacional')?.value) || 4250000;
                    const pub = parseFloat(document.getElementById('numProy_publicos')?.value) || 2800000;
                    const don = parseFloat(document.getElementById('numProy_donantes')?.value) || 950000;
                    const totFon = int + pub + don;
                    const pInt = totFon > 0 ? ((int / totFon) * 100).toFixed(1) + '%' : '53.1%';

                    const ben = parseFloat(document.getElementById('numProy_benDirectas')?.value) || 3450;
                    const mun = parseFloat(document.getElementById('numProy_municipios')?.value) || 46;

                    if (v1) v1.textContent = this.formatearNumero(totProy) + ' proyectos';
                    if (v2) v2.textContent = '$' + (totFon / 1000000).toFixed(1) + 'M MXN';
                    if (b2) b2.textContent = pInt;
                    if (v3) v3.textContent = this.formatearNumero(ben) + ' beneficiarias';
                    if (b3) b3.textContent = mun + ' mun.';
                }
            },

            filtrarCategorias(term) {
                term = (term || '').toLowerCase().trim();
                const items = document.querySelectorAll('#adminSidebarMenu .admin-menu-item');
                items.forEach(item => {
                    const text = (item.textContent || '').toLowerCase();
                    item.style.display = (!term || text.includes(term)) ? '' : 'none';
                });
            },

            cambiarTabSalud(tab) {
                const btnM = document.getElementById('btnTabSaludMujeres');
                const btnN = document.getElementById('btnTabSaludNinas');
                const panM = document.getElementById('panelSaludMujeres');
                const panN = document.getElementById('panelSaludNinas');

                if (tab === 'ninas') {
                    btnM?.classList.remove('active', 'btn-outline-danger');
                    btnM?.classList.add('btn-outline-secondary');
                    btnN?.classList.add('active', 'btn-outline-danger');
                    btnN?.classList.remove('btn-outline-secondary');
                    panM?.classList.add('d-none');
                    panN?.classList.remove('d-none');
                } else {
                    btnN?.classList.remove('active', 'btn-outline-danger');
                    btnN?.classList.add('btn-outline-secondary');
                    btnM?.classList.add('active', 'btn-outline-danger');
                    btnM?.classList.remove('btn-outline-secondary');
                    panN?.classList.add('d-none');
                    panM?.classList.remove('d-none');
                }
            },

            cambiarTabEdu(tab) {
                const btnM = document.getElementById('btnTabEduMujeres');
                const btnN = document.getElementById('btnTabEduNinas');
                const panM = document.getElementById('panelEduMujeres');
                const panN = document.getElementById('panelEduNinas');

                if (tab === 'ninas') {
                    btnM?.classList.remove('active', 'btn-outline-primary');
                    btnM?.classList.add('btn-outline-secondary');
                    btnN?.classList.add('active', 'btn-outline-primary');
                    btnN?.classList.remove('btn-outline-secondary');
                    panM?.classList.add('d-none');
                    panN?.classList.remove('d-none');
                } else {
                    btnN?.classList.remove('active', 'btn-outline-primary');
                    btnN?.classList.add('btn-outline-secondary');
                    btnM?.classList.add('active', 'btn-outline-primary');
                    btnM?.classList.remove('btn-outline-secondary');
                    panN?.classList.add('d-none');
                    panM?.classList.remove('d-none');
                }
            },

            recalcularSalud() {
                // MUJERES
                // 1. Cáncer en Mujeres (5 datos)
                const cMama = parseFloat(document.getElementById('numSalud_cancerMama')?.value) || 0;
                const cCerv = parseFloat(document.getElementById('numSalud_cancerCerv')?.value) || 0;
                const cColo = parseFloat(document.getElementById('numSalud_cancerColo')?.value) || 0;
                const cPulm = parseFloat(document.getElementById('numSalud_cancerPulmon')?.value) || 0;
                const cTiro = parseFloat(document.getElementById('numSalud_cancerTiroides')?.value) || 0;
                const totCancer = cMama + cCerv + cColo + cPulm + cTiro;
                if (totCancer > 0) {
                    const elM = document.getElementById('pctSalud_cancerMama');
                    const elC = document.getElementById('pctSalud_cancerCerv');
                    const elCo = document.getElementById('pctSalud_cancerColo');
                    const elP = document.getElementById('pctSalud_cancerPulmon');
                    const elT = document.getElementById('pctSalud_cancerTiroides');
                    if (elM) elM.textContent = ((cMama / totCancer) * 100).toFixed(1) + '%';
                    if (elC) elC.textContent = ((cCerv / totCancer) * 100).toFixed(1) + '%';
                    if (elCo) elCo.textContent = ((cColo / totCancer) * 100).toFixed(1) + '%';
                    if (elP) elP.textContent = ((cPulm / totCancer) * 100).toFixed(1) + '%';
                    if (elT) elT.textContent = ((cTiro / totCancer) * 100).toFixed(1) + '%';
                }

                // 2. Causas Externas (3 datos)
                const eAcc = parseFloat(document.getElementById('numSalud_externaAccidentes')?.value) || 0;
                const eHom = parseFloat(document.getElementById('numSalud_externaHomicidio')?.value) || 0;
                const eSui = parseFloat(document.getElementById('numSalud_externaSuicidio')?.value) || 0;
                const totExterna = eAcc + eHom + eSui;
                if (totExterna > 0) {
                    const elA = document.getElementById('pctSalud_externaAccidentes');
                    const elH = document.getElementById('pctSalud_externaHomicidio');
                    const elS = document.getElementById('pctSalud_externaSuicidio');
                    if (elA) elA.textContent = ((eAcc / totExterna) * 100).toFixed(1) + '%';
                    if (elH) elH.textContent = ((eHom / totExterna) * 100).toFixed(1) + '%';
                    if (elS) elS.textContent = ((eSui / totExterna) * 100).toFixed(1) + '%';
                }

                // 3. Mortalidad Materna (3 datos)
                const emb = parseFloat(document.getElementById('numSalud_embarazo')?.value) || 0;
                const part = parseFloat(document.getElementById('numSalud_parto')?.value) || 0;
                const puer = parseFloat(document.getElementById('numSalud_puerperio')?.value) || 0;
                const totMat = emb + part + puer;
                if (totMat > 0) {
                    const elE = document.getElementById('pctSalud_embarazo');
                    const elP = document.getElementById('pctSalud_parto');
                    const elPu = document.getElementById('pctSalud_puerperio');
                    if (elE) elE.textContent = ((emb / totMat) * 100).toFixed(1) + '%';
                    if (elP) elP.textContent = ((part / totMat) * 100).toFixed(1) + '%';
                    if (elPu) elPu.textContent = ((puer / totMat) * 100).toFixed(1) + '%';
                }

                // 4. Diabetes Mellitus (7 datos)
                const d1 = parseFloat(document.getElementById('numSalud_diabTipo1')?.value) || 0;
                const d2 = parseFloat(document.getElementById('numSalud_diabTipo2')?.value) || 0;
                const dg = parseFloat(document.getElementById('numSalud_diabGest')?.value) || 0;
                const dm = parseFloat(document.getElementById('numSalud_diabMody')?.value) || 0;
                const dl = parseFloat(document.getElementById('numSalud_diabLada')?.value) || 0;
                const di = parseFloat(document.getElementById('numSalud_diabInsipida')?.value) || 0;
                const ds = parseFloat(document.getElementById('numSalud_diabSec')?.value) || 0;
                const totDiab = d1 + d2 + dg + dm + dl + di + ds;
                if (totDiab > 0) {
                    const el1 = document.getElementById('pctSalud_diabTipo1');
                    const el2 = document.getElementById('pctSalud_diabTipo2');
                    const elg = document.getElementById('pctSalud_diabGest');
                    const elm = document.getElementById('pctSalud_diabMody');
                    const ell = document.getElementById('pctSalud_diabLada');
                    const eli = document.getElementById('pctSalud_diabInsipida');
                    const els = document.getElementById('pctSalud_diabSec');
                    if (el1) el1.textContent = ((d1 / totDiab) * 100).toFixed(1) + '%';
                    if (el2) el2.textContent = ((d2 / totDiab) * 100).toFixed(1) + '%';
                    if (elg) elg.textContent = ((dg / totDiab) * 100).toFixed(1) + '%';
                    if (elm) elm.textContent = ((dm / totDiab) * 100).toFixed(1) + '%';
                    if (ell) ell.textContent = ((dl / totDiab) * 100).toFixed(1) + '%';
                    if (eli) eli.textContent = ((di / totDiab) * 100).toFixed(1) + '%';
                    if (els) els.textContent = ((ds / totDiab) * 100).toFixed(1) + '%';
                }

                // 5. Cardio Vascular (3 datos)
                const h = parseFloat(document.getElementById('numSalud_hipertension')?.value) || 0;
                const inf = parseFloat(document.getElementById('numSalud_infartos')?.value) || 0;
                const ins = parseFloat(document.getElementById('numSalud_insuficiencia')?.value) || 0;
                const totCardio = h + inf + ins;
                if (totCardio > 0) {
                    const elH = document.getElementById('pctSalud_hipertension');
                    const elI = document.getElementById('pctSalud_infartos');
                    const elIns = document.getElementById('pctSalud_insuficiencia');
                    if (elH) elH.textContent = ((h / totCardio) * 100).toFixed(1) + '%';
                    if (elI) elI.textContent = ((inf / totCardio) * 100).toFixed(1) + '%';
                    if (elIns) elIns.textContent = ((ins / totCardio) * 100).toFixed(1) + '%';
                }

                // NIÑAS
                // 1. Mortalidad <1 y Congénita (3 datos)
                const nMal = parseFloat(document.getElementById('numNinas_malformaciones')?.value) || 0;
                const nCard = parseFloat(document.getElementById('numNinas_cardiacos')?.value) || 0;
                const nGen = parseFloat(document.getElementById('numNinas_geneticas')?.value) || 0;
                const totNinasMort = nMal + nCard + nGen;
                if (totNinasMort > 0) {
                    const elMal = document.getElementById('pctNinas_malformaciones');
                    const elCard = document.getElementById('pctNinas_cardiacos');
                    const elGen = document.getElementById('pctNinas_geneticas');
                    if (elMal) elMal.textContent = ((nMal / totNinasMort) * 100).toFixed(1) + '%';
                    if (elCard) elCard.textContent = ((nCard / totNinasMort) * 100).toFixed(1) + '%';
                    if (elGen) elGen.textContent = ((nGen / totNinasMort) * 100).toFixed(1) + '%';
                }

                // 2. Infecciones (4 datos)
                const nResp = parseFloat(document.getElementById('numNinas_respiratorias')?.value) || 0;
                const nDia = parseFloat(document.getElementById('numNinas_diarreas')?.value) || 0;
                const nMen = parseFloat(document.getElementById('numNinas_meningitis')?.value) || 0;
                const nSep = parseFloat(document.getElementById('numNinas_sepsis')?.value) || 0;
                const totNinasInf = nResp + nDia + nMen + nSep;
                if (totNinasInf > 0) {
                    const elR = document.getElementById('pctNinas_respiratorias');
                    const elD = document.getElementById('pctNinas_diarreas');
                    const elM = document.getElementById('pctNinas_meningitis');
                    const elS = document.getElementById('pctNinas_sepsis');
                    if (elR) elR.textContent = ((nResp / totNinasInf) * 100).toFixed(1) + '%';
                    if (elD) elD.textContent = ((nDia / totNinasInf) * 100).toFixed(1) + '%';
                    if (elM) elM.textContent = ((nMen / totNinasInf) * 100).toFixed(1) + '%';
                    if (elS) elS.textContent = ((nSep / totNinasInf) * 100).toFixed(1) + '%';
                }

                // 3. Desnutrición (3 datos)
                const nAgu = parseFloat(document.getElementById('numNinas_desnAguda')?.value) || 0;
                const nCro = parseFloat(document.getElementById('numNinas_desnCronica')?.value) || 0;
                const nMic = parseFloat(document.getElementById('numNinas_micronutrientes')?.value) || 0;
                const totNinasDes = nAgu + nCro + nMic;
                if (totNinasDes > 0) {
                    const elA = document.getElementById('pctNinas_desnAguda');
                    const elC = document.getElementById('pctNinas_desnCronica');
                    const elM = document.getElementById('pctNinas_micronutrientes');
                    if (elA) elA.textContent = ((nAgu / totNinasDes) * 100).toFixed(1) + '%';
                    if (elC) elC.textContent = ((nCro / totNinasDes) * 100).toFixed(1) + '%';
                    if (elM) elM.textContent = ((nMic / totNinasDes) * 100).toFixed(1) + '%';
                }

                // 4. Accidentes y Violencias (4 datos)
                const nAcc = parseFloat(document.getElementById('numNinas_accHogar')?.value) || 0;
                const nVio = parseFloat(document.getElementById('numNinas_violencia')?.value) || 0;
                const nAbu = parseFloat(document.getElementById('numNinas_abuso')?.value) || 0;
                const nHom = parseFloat(document.getElementById('numNinas_homicidioSuicidio')?.value) || 0;
                const totNinasAcc = nAcc + nVio + nAbu + nHom;
                if (totNinasAcc > 0) {
                    const elAc = document.getElementById('pctNinas_accHogar');
                    const elVi = document.getElementById('pctNinas_violencia');
                    const elAb = document.getElementById('pctNinas_abuso');
                    const elHo = document.getElementById('pctNinas_homicidioSuicidio');
                    if (elAc) elAc.textContent = ((nAcc / totNinasAcc) * 100).toFixed(1) + '%';
                    if (elVi) elVi.textContent = ((nVio / totNinasAcc) * 100).toFixed(1) + '%';
                    if (elAb) elAb.textContent = ((nAbu / totNinasAcc) * 100).toFixed(1) + '%';
                    if (elHo) elHo.textContent = ((nHom / totNinasAcc) * 100).toFixed(1) + '%';
                }

                // 5. Consolidado de Niñas (4 datos)
                const nCInf = parseFloat(document.getElementById('numNinas_consInfecciones')?.value) || 0;
                const nCDes = parseFloat(document.getElementById('numNinas_consDesnutricion')?.value) || 0;
                const nCMor = parseFloat(document.getElementById('numNinas_consMortalidadMenor1')?.value) || 0;
                const nCVio = parseFloat(document.getElementById('numNinas_consViolencias')?.value) || 0;
                const totNinasCons = nCInf + nCDes + nCMor + nCVio;
                if (totNinasCons > 0) {
                    const elCI = document.getElementById('pctNinas_consInfecciones');
                    const elCD = document.getElementById('pctNinas_consDesnutricion');
                    const elCM = document.getElementById('pctNinas_consMortalidadMenor1');
                    const elCV = document.getElementById('pctNinas_consViolencias');
                    if (elCI) elCI.textContent = ((nCInf / totNinasCons) * 100).toFixed(1) + '%';
                    if (elCD) elCD.textContent = ((nCDes / totNinasCons) * 100).toFixed(1) + '%';
                    if (elCM) elCM.textContent = ((nCMor / totNinasCons) * 100).toFixed(1) + '%';
                    if (elCV) elCV.textContent = ((nCVio / totNinasCons) * 100).toFixed(1) + '%';
                }

                // Actualizar KPI cards en vivo
                this.actualizarKpis('salud');
            },

            recalcularEducacion() {
                // MUJERES (4 ÁREAS)
                // 1. Nivel avanzado (3 datos)
                const b = parseFloat(document.getElementById('numEdu_bachillerato')?.value) || 0;
                const l = parseFloat(document.getElementById('numEdu_licenciatura')?.value) || 0;
                const p = parseFloat(document.getElementById('numEdu_posgrado')?.value) || 0;
                const totAvanzado = b + l + p;
                if (totAvanzado > 0) {
                    const elB = document.getElementById('pctEdu_bachillerato');
                    const elL = document.getElementById('pctEdu_licenciatura');
                    const elP = document.getElementById('pctEdu_posgrado');
                    if (elB) elB.textContent = ((b / totAvanzado) * 100).toFixed(1) + '%';
                    if (elL) elL.textContent = ((l / totAvanzado) * 100).toFixed(1) + '%';
                    if (elP) elP.textContent = ((p / totAvanzado) * 100).toFixed(1) + '%';
                }

                // 2. Fuera del sistema (3 datos)
                const cui = parseFloat(document.getElementById('numEdu_cuidados')?.value) || 0;
                const rec = parseFloat(document.getElementById('numEdu_recursos')?.value) || 0;
                const mat = parseFloat(document.getElementById('numEdu_maternidad')?.value) || 0;
                const totFuera = cui + rec + mat;
                if (totFuera > 0) {
                    const elC = document.getElementById('pctEdu_cuidados');
                    const elR = document.getElementById('pctEdu_recursos');
                    const elM = document.getElementById('pctEdu_maternidad');
                    if (elC) elC.textContent = ((cui / totFuera) * 100).toFixed(1) + '%';
                    if (elR) elR.textContent = ((rec / totFuera) * 100).toFixed(1) + '%';
                    if (elM) elM.textContent = ((mat / totFuera) * 100).toFixed(1) + '%';
                }

                // 3. Analfabetismo en Mujeres (2 datos)
                const ind = parseFloat(document.getElementById('numEdu_analfIndigena')?.value) || 0;
                const noInd = parseFloat(document.getElementById('numEdu_analfNoIndigena')?.value) || 0;
                const totAnalf = ind + noInd;
                if (totAnalf > 0) {
                    const elI = document.getElementById('pctEdu_analfIndigena');
                    const elN = document.getElementById('pctEdu_analfNoIndigena');
                    if (elI) elI.textContent = ((ind / totAnalf) * 100).toFixed(1) + '%';
                    if (elN) elN.textContent = ((noInd / totAnalf) * 100).toFixed(1) + '%';
                }

                // 4. STEM y Carreras Universitarias (5 datos)
                const c1 = parseFloat(document.getElementById('numEdu_ciencias')?.value) || 0;
                const c2 = parseFloat(document.getElementById('numEdu_tecnologia')?.value) || 0;
                const c3 = parseFloat(document.getElementById('numEdu_ingenieria')?.value) || 0;
                const c4 = parseFloat(document.getElementById('numEdu_matematicas')?.value) || 0;
                const c5 = parseFloat(document.getElementById('numEdu_saludEdu')?.value) || 0;
                const totStem = c1 + c2 + c3 + c4 + c5;
                if (totStem > 0) {
                    const el1 = document.getElementById('pctEdu_ciencias');
                    const el2 = document.getElementById('pctEdu_tecnologia');
                    const el3 = document.getElementById('pctEdu_ingenieria');
                    const el4 = document.getElementById('pctEdu_matematicas');
                    const el5 = document.getElementById('pctEdu_saludEdu');
                    if (el1) el1.textContent = ((c1 / totStem) * 100).toFixed(1) + '%';
                    if (el2) el2.textContent = ((c2 / totStem) * 100).toFixed(1) + '%';
                    if (el3) el3.textContent = ((c3 / totStem) * 100).toFixed(1) + '%';
                    if (el4) el4.textContent = ((c4 / totStem) * 100).toFixed(1) + '%';
                    if (el5) el5.textContent = ((c5 / totStem) * 100).toFixed(1) + '%';
                }

                // NIÑAS (4 ÁREAS)
                // 1. Acceso y Permanencia Escolar (3 datos)
                const nInsc = parseFloat(document.getElementById('numEduNinas_inscritas')?.value) || 0;
                const nNoAs = parseFloat(document.getElementById('numEduNinas_noAsisten')?.value) || 0;
                const nAban = parseFloat(document.getElementById('numEduNinas_abandono')?.value) || 0;
                const totAcceso = nInsc + nNoAs + nAban;
                if (totAcceso > 0) {
                    const elIn = document.getElementById('pctEduNinas_inscritas');
                    const elNo = document.getElementById('pctEduNinas_noAsisten');
                    const elAb = document.getElementById('pctEduNinas_abandono');
                    if (elIn) elIn.textContent = ((nInsc / totAcceso) * 100).toFixed(1) + '%';
                    if (elNo) elNo.textContent = ((nNoAs / totAcceso) * 100).toFixed(1) + '%';
                    if (elAb) elAb.textContent = ((nAban / totAcceso) * 100).toFixed(1) + '%';
                }

                // 2. Alfabetización en Niñas (3 datos)
                const nLeer = parseFloat(document.getElementById('numEduNinas_sabenLeer')?.value) || 0;
                const nNoLeer = parseFloat(document.getElementById('numEduNinas_noSabenLeer')?.value) || 0;
                const nProc = parseFloat(document.getElementById('numEduNinas_proceso')?.value) || 0;
                const totAlfa = nLeer + nNoLeer + nProc;
                if (totAlfa > 0) {
                    const elLe = document.getElementById('pctEduNinas_sabenLeer');
                    const elNL = document.getElementById('pctEduNinas_noSabenLeer');
                    const elPr = document.getElementById('pctEduNinas_proceso');
                    if (elLe) elLe.textContent = ((nLeer / totAlfa) * 100).toFixed(1) + '%';
                    if (elNL) elNL.textContent = ((nNoLeer / totAlfa) * 100).toFixed(1) + '%';
                    if (elPr) elPr.textContent = ((nProc / totAlfa) * 100).toFixed(1) + '%';
                }

                // 3. Niñas Fuera de la Escuela (4 datos)
                const nRec = parseFloat(document.getElementById('numEduNinas_faltaRecursos')?.value) || 0;
                const nCui = parseFloat(document.getElementById('numEduNinas_cuidados')?.value) || 0;
                const nLej = parseFloat(document.getElementById('numEduNinas_lejania')?.value) || 0;
                const nTra = parseFloat(document.getElementById('numEduNinas_trabajoInfantil')?.value) || 0;
                const totNinasFuera = nRec + nCui + nLej + nTra;
                if (totNinasFuera > 0) {
                    const elRe = document.getElementById('pctEduNinas_faltaRecursos');
                    const elCu = document.getElementById('pctEduNinas_cuidados');
                    const elLe = document.getElementById('pctEduNinas_lejania');
                    const elTr = document.getElementById('pctEduNinas_trabajoInfantil');
                    if (elRe) elRe.textContent = ((nRec / totNinasFuera) * 100).toFixed(1) + '%';
                    if (elCu) elCu.textContent = ((nCui / totNinasFuera) * 100).toFixed(1) + '%';
                    if (elLe) elLe.textContent = ((nLej / totNinasFuera) * 100).toFixed(1) + '%';
                    if (elTr) elTr.textContent = ((nTra / totNinasFuera) * 100).toFixed(1) + '%';
                }

                // 4. Consolidado Escolar en Niñas (4 datos)
                const cPrim = parseFloat(document.getElementById('numEduNinas_concluyenPrimaria')?.value) || 0;
                const cSec = parseFloat(document.getElementById('numEduNinas_ingresanSecundaria')?.value) || 0;
                const cRez = parseFloat(document.getElementById('numEduNinas_rezago')?.value) || 0;
                const cDes = parseFloat(document.getElementById('numEduNinas_desercion')?.value) || 0;
                const elCP = document.getElementById('pctEduNinas_concluyenPrimaria');
                const elCS = document.getElementById('pctEduNinas_ingresanSecundaria');
                const elCR = document.getElementById('pctEduNinas_rezago');
                const elCD = document.getElementById('pctEduNinas_desercion');
                if (elCP) elCP.textContent = cPrim.toFixed(1) + '%';
                if (elCS) elCS.textContent = cSec.toFixed(1) + '%';
                if (elCR) elCR.textContent = cRez.toFixed(1) + '%';
                if (elCD) elCD.textContent = cDes.toFixed(1) + '%';

                this.actualizarKpis('educacion');
            },

            recalcularVivienda() {
                // 1. Tenencia de la Vivienda (4 datos)
                const p = parseFloat(document.getElementById('numViv_propia')?.value) || 0;
                const r = parseFloat(document.getElementById('numViv_rentan')?.value) || 0;
                const s = parseFloat(document.getElementById('numViv_prestada')?.value) || 0;
                const e = parseFloat(document.getElementById('numViv_ejidal')?.value) || 0;
                const totTen = p + r + s + e;
                if (totTen > 0) {
                    const elP = document.getElementById('pctViv_propia');
                    const elR = document.getElementById('pctViv_rentan');
                    const elS = document.getElementById('pctViv_prestada');
                    const elE = document.getElementById('pctViv_ejidal');
                    if (elP) elP.textContent = ((p / totTen) * 100).toFixed(1) + '%';
                    if (elR) elR.textContent = ((r / totTen) * 100).toFixed(1) + '%';
                    if (elS) elS.textContent = ((s / totTen) * 100).toFixed(1) + '%';
                    if (elE) elE.textContent = ((e / totTen) * 100).toFixed(1) + '%';
                }

                // 2. Jefatura Femenina y Vulnerabilidad (4 datos) - Base 378,280 hogares
                const hHac = parseFloat(document.getElementById('numViv_hacinamiento')?.value) || 0;
                const hCua = parseFloat(document.getElementById('numViv_unCuarto')?.value) || 0;
                const hBan = parseFloat(document.getElementById('numViv_sinBano')?.value) || 0;
                const hEsc = parseFloat(document.getElementById('numViv_sinEscrituras')?.value) || 0;
                const baseHogares = 378280;
                const elHac = document.getElementById('pctViv_hacinamiento');
                const elCua = document.getElementById('pctViv_unCuarto');
                const elBan = document.getElementById('pctViv_sinBano');
                const elEsc = document.getElementById('pctViv_sinEscrituras');
                if (elHac) elHac.textContent = ((hHac / baseHogares) * 100).toFixed(1) + '%';
                if (elCua) elCua.textContent = ((hCua / baseHogares) * 100).toFixed(1) + '%';
                if (elBan) elBan.textContent = ((hBan / baseHogares) * 100).toFixed(1) + '%';
                if (elEsc) elEsc.textContent = ((hEsc / baseHogares) * 100).toFixed(1) + '%';

                // 3. Condiciones y Servicios Básicos (4 datos) - Base 1,125,849 viviendas
                const sAgua = parseFloat(document.getElementById('numViv_agua')?.value) || 0;
                const sDren = parseFloat(document.getElementById('numViv_drenaje')?.value) || 0;
                const sLuz = parseFloat(document.getElementById('numViv_luz')?.value) || 0;
                const sPav = parseFloat(document.getElementById('numViv_pavimento')?.value) || 0;
                const baseViv = 1125849;
                const elAgua = document.getElementById('pctViv_agua');
                const elDren = document.getElementById('pctViv_drenaje');
                const elLuz = document.getElementById('pctViv_luz');
                const elPav = document.getElementById('pctViv_pavimento');
                if (elAgua) elAgua.textContent = ((sAgua / baseViv) * 100).toFixed(1) + '%';
                if (elDren) elDren.textContent = ((sDren / baseViv) * 100).toFixed(1) + '%';
                if (elLuz) elLuz.textContent = ((sLuz / baseViv) * 100).toFixed(1) + '%';
                if (elPav) elPav.textContent = ((sPav / baseViv) * 100).toFixed(1) + '%';

                // 4. Calidad de Materiales en la Vivienda (3 datos) - Base 1,125,849 viviendas
                const mLam = parseFloat(document.getElementById('numViv_techoLamina')?.value) || 0;
                const mTie = parseFloat(document.getElementById('numViv_pisoTierra')?.value) || 0;
                const mMuro = parseFloat(document.getElementById('numViv_murosPrecarios')?.value) || 0;
                const elLam = document.getElementById('pctViv_techoLamina');
                const elTie = document.getElementById('pctViv_pisoTierra');
                const elMuro = document.getElementById('pctViv_murosPrecarios');
                if (elLam) elLam.textContent = ((mLam / baseViv) * 100).toFixed(1) + '%';
                if (elTie) elTie.textContent = ((mTie / baseViv) * 100).toFixed(1) + '%';
                if (elMuro) elMuro.textContent = ((mMuro / baseViv) * 100).toFixed(1) + '%';

                this.actualizarKpis('vivienda');
            },

            recalcularIngreso() {
                // 1. Trabajo Formal vs No Formal (2 datos)
                const f = parseFloat(document.getElementById('numIng_formal')?.value) || 0;
                const i = parseFloat(document.getElementById('numIng_informal')?.value) || 0;
                const totOcupadas = f + i;
                if (totOcupadas > 0) {
                    const elF = document.getElementById('pctIng_formal');
                    const elI = document.getElementById('pctIng_informal');
                    if (elF) elF.textContent = ((f / totOcupadas) * 100).toFixed(1) + '%';
                    if (elI) elI.textContent = ((i / totOcupadas) * 100).toFixed(1) + '%';
                }

                // 2. Modalidades del Trabajo No Formal Femenino (4 datos)
                const mAmb = parseFloat(document.getElementById('numIng_ambulante')?.value) || 0;
                const mDom = parseFloat(document.getElementById('numIng_domestico')?.value) || 0;
                const mAut = parseFloat(document.getElementById('numIng_autoempleo')?.value) || 0;
                const mJor = parseFloat(document.getElementById('numIng_jornaleras')?.value) || 0;
                const totNoFormal = mAmb + mDom + mAut + mJor;
                if (totNoFormal > 0) {
                    const elAmb = document.getElementById('pctIng_ambulante');
                    const elDom = document.getElementById('pctIng_domestico');
                    const elAut = document.getElementById('pctIng_autoempleo');
                    const elJor = document.getElementById('pctIng_jornaleras');
                    if (elAmb) elAmb.textContent = ((mAmb / totNoFormal) * 100).toFixed(1) + '%';
                    if (elDom) elDom.textContent = ((mDom / totNoFormal) * 100).toFixed(1) + '%';
                    if (elAut) elAut.textContent = ((mAut / totNoFormal) * 100).toFixed(1) + '%';
                    if (elJor) elJor.textContent = ((mJor / totNoFormal) * 100).toFixed(1) + '%';
                }

                // 3. Acceso a Prestaciones Laborales (4 datos) - Base totOcupadas (o 742,850)
                const baseOcup = totOcupadas > 0 ? totOcupadas : 742850;
                const pSin = parseFloat(document.getElementById('numIng_sinPrestaciones')?.value) || 0;
                const pAgu = parseFloat(document.getElementById('numIng_aguinaldo')?.value) || 0;
                const pVac = parseFloat(document.getElementById('numIng_vacaciones')?.value) || 0;
                const pSeg = parseFloat(document.getElementById('numIng_seguridadSocial')?.value) || 0;
                const elSin = document.getElementById('pctIng_sinPrestaciones');
                const elAgu = document.getElementById('pctIng_aguinaldo');
                const elVac = document.getElementById('pctIng_vacaciones');
                const elSeg = document.getElementById('pctIng_seguridadSocial');
                if (elSin) elSin.textContent = ((pSin / baseOcup) * 100).toFixed(1) + '%';
                if (elAgu) elAgu.textContent = ((pAgu / baseOcup) * 100).toFixed(1) + '%';
                if (elVac) elVac.textContent = ((pVac / baseOcup) * 100).toFixed(1) + '%';
                if (elSeg) elSeg.textContent = ((pSeg / baseOcup) * 100).toFixed(1) + '%';

                // 4. Dependencia de Remesas Familiares (4 datos) - Base 322,400 hogares
                const baseRem = 322400;
                const rHog = parseFloat(document.getElementById('numIng_hogaresRemesas')?.value) || 0;
                const rAli = parseFloat(document.getElementById('numIng_gastoAlimentos')?.value) || 0;
                const rSal = parseFloat(document.getElementById('numIng_gastoSalud')?.value) || 0;
                const rEdu = parseFloat(document.getElementById('numIng_gastoEducacion')?.value) || 0;
                const elHog = document.getElementById('pctIng_hogaresRemesas');
                const elAli = document.getElementById('pctIng_gastoAlimentos');
                const elSal = document.getElementById('pctIng_gastoSalud');
                const elEdu = document.getElementById('pctIng_gastoEducacion');
                if (elHog) elHog.textContent = ((rHog / baseRem) * 100).toFixed(1) + '%';
                if (elAli) elAli.textContent = ((rAli / baseRem) * 100).toFixed(1) + '%';
                if (elSal) elSal.textContent = ((rSal / baseRem) * 100).toFixed(1) + '%';
                if (elEdu) elEdu.textContent = ((rEdu / baseRem) * 100).toFixed(1) + '%';

                this.actualizarKpis('ingreso');
            },

            recalcularPsicologia() {
                // 1. Tipo de Atención y Citas
                const ini = parseFloat(document.getElementById('numPsic_inicial')?.value) || 0;
                const con = parseFloat(document.getElementById('numPsic_continua')?.value) || 0;
                const urg = parseFloat(document.getElementById('numPsic_urgencia')?.value) || 0;
                const can = parseFloat(document.getElementById('numPsic_canalizacion')?.value) || 0;
                const totCitas = ini + con + urg + can;
                if (totCitas > 0) {
                    const elIn = document.getElementById('pctPsic_inicial');
                    const elCo = document.getElementById('pctPsic_continua');
                    const elUr = document.getElementById('pctPsic_urgencia');
                    const elCa = document.getElementById('pctPsic_canalizacion');
                    if (elIn) elIn.textContent = ((ini / totCitas) * 100).toFixed(1) + '%';
                    if (elCo) elCo.textContent = ((con / totCitas) * 100).toFixed(1) + '%';
                    if (elUr) elUr.textContent = ((urg / totCitas) * 100).toFixed(1) + '%';
                    if (elCa) elCa.textContent = ((can / totCitas) * 100).toFixed(1) + '%';
                }

                // 2. Modalidad del Servicio
                const pres = parseFloat(document.getElementById('numPsic_presencial')?.value) || 0;
                const tel = parseFloat(document.getElementById('numPsic_telefonica')?.value) || 0;
                const vir = parseFloat(document.getElementById('numPsic_virtual')?.value) || 0;
                const totMod = pres + tel + vir;
                if (totMod > 0) {
                    const elPr = document.getElementById('pctPsic_presencial');
                    const elTe = document.getElementById('pctPsic_telefonica');
                    const elVi = document.getElementById('pctPsic_virtual');
                    if (elPr) elPr.textContent = ((pres / totMod) * 100).toFixed(1) + '%';
                    if (elTe) elTe.textContent = ((tel / totMod) * 100).toFixed(1) + '%';
                    if (elVi) elVi.textContent = ((vir / totMod) * 100).toFixed(1) + '%';
                }

                // 3. Estado de los Casos
                const proc = parseFloat(document.getElementById('numPsic_enProceso')?.value) || 0;
                const conc = parseFloat(document.getElementById('numPsic_concluidos')?.value) || 0;
                const plan = parseFloat(document.getElementById('numPsic_planVida')?.value) || 0;
                const aban = parseFloat(document.getElementById('numPsic_abandono')?.value) || 0;
                const totCas = proc + conc + plan + aban;
                if (totCas > 0) {
                    const elPro = document.getElementById('pctPsic_enProceso');
                    const elCon = document.getElementById('pctPsic_concluidos');
                    const elPla = document.getElementById('pctPsic_planVida');
                    const elAba = document.getElementById('pctPsic_abandono');
                    if (elPro) elPro.textContent = ((proc / totCas) * 100).toFixed(1) + '%';
                    if (elCon) elCon.textContent = ((conc / totCas) * 100).toFixed(1) + '%';
                    if (elPla) elPla.textContent = ((plan / totCas) * 100).toFixed(1) + '%';
                    if (elAba) elAba.textContent = ((aban / totCas) * 100).toFixed(1) + '%';
                }

                // 4. Problemáticas y Diagnósticos
                const vPs = parseFloat(document.getElementById('numPsic_violenciaPsic')?.value) || 0;
                const ans = parseFloat(document.getElementById('numPsic_ansiedad')?.value) || 0;
                const due = parseFloat(document.getElementById('numPsic_duelo')?.value) || 0;
                const tra = parseFloat(document.getElementById('numPsic_trauma')?.value) || 0;
                const totProb = vPs + ans + due + tra;
                if (totProb > 0) {
                    const elVP = document.getElementById('pctPsic_violenciaPsic');
                    const elAn = document.getElementById('pctPsic_ansiedad');
                    const elDu = document.getElementById('pctPsic_duelo');
                    const elTr = document.getElementById('pctPsic_trauma');
                    if (elVP) elVP.textContent = ((vPs / totProb) * 100).toFixed(1) + '%';
                    if (elAn) elAn.textContent = ((ans / totProb) * 100).toFixed(1) + '%';
                    if (elDu) elDu.textContent = ((due / totProb) * 100).toFixed(1) + '%';
                    if (elTr) elTr.textContent = ((tra / totProb) * 100).toFixed(1) + '%';
                }

                this.actualizarKpis('psicologia');
            },

            recalcularJuicios() {
                // 1. Servicios y Acompañamiento
                const ase = parseFloat(document.getElementById('numJui_asesorias')?.value) || 0;
                const aud = parseFloat(document.getElementById('numJui_audiencias')?.value) || 0;
                const car = parseFloat(document.getElementById('numJui_carpetas')?.value) || 0;
                const tel = parseFloat(document.getElementById('numJui_telefonicas')?.value) || 0;
                const totServ = ase + aud + car + tel;
                if (totServ > 0) {
                    const elAs = document.getElementById('pctJui_asesorias');
                    const elAu = document.getElementById('pctJui_audiencias');
                    const elCa = document.getElementById('pctJui_carpetas');
                    const elTe = document.getElementById('pctJui_telefonicas');
                    if (elAs) elAs.textContent = ((ase / totServ) * 100).toFixed(1) + '%';
                    if (elAu) elAu.textContent = ((aud / totServ) * 100).toFixed(1) + '%';
                    if (elCa) elCa.textContent = ((car / totServ) * 100).toFixed(1) + '%';
                    if (elTe) elTe.textContent = ((tel / totServ) * 100).toFixed(1) + '%';
                }

                // 2. Materia del Litigio
                const pen = parseFloat(document.getElementById('numJui_pension')?.value) || 0;
                const cus = parseFloat(document.getElementById('numJui_custodia')?.value) || 0;
                const div = parseFloat(document.getElementById('numJui_divorcio')?.value) || 0;
                const ord = parseFloat(document.getElementById('numJui_ordenes')?.value) || 0;
                const totMat = pen + cus + div + ord;
                if (totMat > 0) {
                    const elPe = document.getElementById('pctJui_pension');
                    const elCu = document.getElementById('pctJui_custodia');
                    const elDi = document.getElementById('pctJui_divorcio');
                    const elOr = document.getElementById('pctJui_ordenes');
                    if (elPe) elPe.textContent = ((pen / totMat) * 100).toFixed(1) + '%';
                    if (elCu) elCu.textContent = ((cus / totMat) * 100).toFixed(1) + '%';
                    if (elDi) elDi.textContent = ((div / totMat) * 100).toFixed(1) + '%';
                    if (elOr) elOr.textContent = ((ord / totMat) * 100).toFixed(1) + '%';
                }

                // 3. Estado Procesal
                const sent = parseFloat(document.getElementById('numJui_sentencia')?.value) || 0;
                const act = parseFloat(document.getElementById('numJui_activo')?.value) || 0;
                const conv = parseFloat(document.getElementById('numJui_convenios')?.value) || 0;
                const conc = parseFloat(document.getElementById('numJui_concluidos')?.value) || 0;
                const totExp = sent + act + conv + conc;
                if (totExp > 0) {
                    const elSe = document.getElementById('pctJui_sentencia');
                    const elAc = document.getElementById('pctJui_activo');
                    const elCo = document.getElementById('pctJui_convenios');
                    const elCn = document.getElementById('pctJui_concluidos');
                    if (elSe) elSe.textContent = ((sent / totExp) * 100).toFixed(1) + '%';
                    if (elAc) elAc.textContent = ((act / totExp) * 100).toFixed(1) + '%';
                    if (elCo) elCo.textContent = ((conv / totExp) * 100).toFixed(1) + '%';
                    if (elCn) elCn.textContent = ((conc / totExp) * 100).toFixed(1) + '%';
                }

                // 4. Radicación en Juzgados
                const jCen = parseFloat(document.getElementById('numJui_juzgCentro')?.value) || 0;
                const jReg = parseFloat(document.getElementById('numJui_juzgRegionales')?.value) || 0;
                const jPen = parseFloat(document.getElementById('numJui_juzgPenal')?.value) || 0;
                const totJuzg = jCen + jReg + jPen;
                if (totJuzg > 0) {
                    const elJC = document.getElementById('pctJui_juzgCentro');
                    const elJR = document.getElementById('pctJui_juzgRegionales');
                    const elJP = document.getElementById('pctJui_juzgPenal');
                    if (elJC) elJC.textContent = ((jCen / totJuzg) * 100).toFixed(1) + '%';
                    if (elJR) elJR.textContent = ((jReg / totJuzg) * 100).toFixed(1) + '%';
                    if (elJP) elJP.textContent = ((jPen / totJuzg) * 100).toFixed(1) + '%';
                }

                this.actualizarKpis('juicios');
            },

            recalcularAtendidas() {
                // 1. Grupo Etario
                const adu = parseFloat(document.getElementById('numAten_adultas')?.value) || 0;
                const adl = parseFloat(document.getElementById('numAten_adolescentes')?.value) || 0;
                const tut = parseFloat(document.getElementById('numAten_tutoras')?.value) || 0;
                const inf = parseFloat(document.getElementById('numAten_infantes')?.value) || 0;
                const totEtario = adu + adl + tut + inf;
                if (totEtario > 0) {
                    const elAd = document.getElementById('pctAten_adultas');
                    const elAl = document.getElementById('pctAten_adolescentes');
                    const elTu = document.getElementById('pctAten_tutoras');
                    const elIn = document.getElementById('pctAten_infantes');
                    if (elAd) elAd.textContent = ((adu / totEtario) * 100).toFixed(1) + '%';
                    if (elAl) elAl.textContent = ((adl / totEtario) * 100).toFixed(1) + '%';
                    if (elTu) elTu.textContent = ((tut / totEtario) * 100).toFixed(1) + '%';
                    if (elIn) elIn.textContent = ((inf / totEtario) * 100).toFixed(1) + '%';
                }

                // 2. Identidad y Procedencia
                const ind = parseFloat(document.getElementById('numAten_indigenas')?.value) || 0;
                const nInd = parseFloat(document.getElementById('numAten_noIndigenas')?.value) || 0;
                const totIden = ind + nInd;
                if (totIden > 0) {
                    const elIn = document.getElementById('pctAten_indigenas');
                    const elNI = document.getElementById('pctAten_noIndigenas');
                    if (elIn) elIn.textContent = ((ind / totIden) * 100).toFixed(1) + '%';
                    if (elNI) elNI.textContent = ((nInd / totIden) * 100).toFixed(1) + '%';
                }

                const rur = parseFloat(document.getElementById('numAten_rural')?.value) || 0;
                const urb = parseFloat(document.getElementById('numAten_urbana')?.value) || 0;
                const totRes = rur + urb;
                if (totRes > 0) {
                    const elRu = document.getElementById('pctAten_rural');
                    const elUr = document.getElementById('pctAten_urbana');
                    if (elRu) elRu.textContent = ((rur / totRes) * 100).toFixed(1) + '%';
                    if (elUr) elUr.textContent = ((urb / totRes) * 100).toFixed(1) + '%';
                }

                // 3. Tipo de Violencia
                const vPs = parseFloat(document.getElementById('numAten_vPsic')?.value) || 0;
                const vFi = parseFloat(document.getElementById('numAten_vFis')?.value) || 0;
                const vEc = parseFloat(document.getElementById('numAten_vEcon')?.value) || 0;
                const vSe = parseFloat(document.getElementById('numAten_vSex')?.value) || 0;
                const totVio = vPs + vFi + vEc + vSe;
                if (totVio > 0) {
                    const elVP = document.getElementById('pctAten_vPsic');
                    const elVF = document.getElementById('pctAten_vFis');
                    const elVE = document.getElementById('pctAten_vEcon');
                    const elVS = document.getElementById('pctAten_vSex');
                    if (elVP) elVP.textContent = ((vPs / totVio) * 100).toFixed(1) + '%';
                    if (elVF) elVF.textContent = ((vFi / totVio) * 100).toFixed(1) + '%';
                    if (elVE) elVE.textContent = ((vEc / totVio) * 100).toFixed(1) + '%';
                    if (elVS) elVS.textContent = ((vSe / totVio) * 100).toFixed(1) + '%';
                }

                // 4. Regiones
                const rVal = parseFloat(document.getElementById('numAten_regValles')?.value) || 0;
                const rIst = parseFloat(document.getElementById('numAten_regIstmo')?.value) || 0;
                const rCos = parseFloat(document.getElementById('numAten_regCosta')?.value) || 0;
                const rSie = parseFloat(document.getElementById('numAten_regSierras')?.value) || 0;
                const rNor = parseFloat(document.getElementById('numAten_regNorte')?.value) || 0;
                const totReg = rVal + rIst + rCos + rSie + rNor;
                if (totReg > 0) {
                    const elVa = document.getElementById('pctAten_regValles');
                    const elIs = document.getElementById('pctAten_regIstmo');
                    const elCo = document.getElementById('pctAten_regCosta');
                    const elSi = document.getElementById('pctAten_regSierras');
                    const elNo = document.getElementById('pctAten_regNorte');
                    if (elVa) elVa.textContent = ((rVal / totReg) * 100).toFixed(1) + '%';
                    if (elIs) elIs.textContent = ((rIst / totReg) * 100).toFixed(1) + '%';
                    if (elCo) elCo.textContent = ((rCos / totReg) * 100).toFixed(1) + '%';
                    if (elSi) elSi.textContent = ((rSie / totReg) * 100).toFixed(1) + '%';
                    if (elNo) elNo.textContent = ((rNor / totReg) * 100).toFixed(1) + '%';
                }

                this.actualizarKpis('atendidas');
            },

            recalcularFeminicidios() {
                // 1. Regiones
                const ist = parseFloat(document.getElementById('numFem_istmo')?.value) || 0;
                const val = parseFloat(document.getElementById('numFem_valles')?.value) || 0;
                const cos = parseFloat(document.getElementById('numFem_costa')?.value) || 0;
                const sur = parseFloat(document.getElementById('numFem_sierraSur')?.value) || 0;
                const mix = parseFloat(document.getElementById('numFem_mixteca')?.value) || 0;
                const otr = parseFloat(document.getElementById('numFem_otrasReg')?.value) || 0;
                const totReg = ist + val + cos + sur + mix + otr;
                if (totReg > 0) {
                    const elIs = document.getElementById('pctFem_istmo');
                    const elVa = document.getElementById('pctFem_valles');
                    const elCo = document.getElementById('pctFem_costa');
                    const elSu = document.getElementById('pctFem_sierraSur');
                    const elMi = document.getElementById('pctFem_mixteca');
                    const elOt = document.getElementById('pctFem_otrasReg');
                    if (elIs) elIs.textContent = ((ist / totReg) * 100).toFixed(1) + '%';
                    if (elVa) elVa.textContent = ((val / totReg) * 100).toFixed(1) + '%';
                    if (elCo) elCo.textContent = ((cos / totReg) * 100).toFixed(1) + '%';
                    if (elSu) elSu.textContent = ((sur / totReg) * 100).toFixed(1) + '%';
                    if (elMi) elMi.textContent = ((mix / totReg) * 100).toFixed(1) + '%';
                    if (elOt) elOt.textContent = ((otr / totReg) * 100).toFixed(1) + '%';
                }

                // 2. Arma / Causa de Muerte
                const fue = parseFloat(document.getElementById('numFem_armaFuego')?.value) || 0;
                const bla = parseFloat(document.getElementById('numFem_armaBlanca')?.value) || 0;
                const fis = parseFloat(document.getElementById('numFem_fuerzaFisica')?.value) || 0;
                const nes = parseFloat(document.getElementById('numFem_noEspec')?.value) || 0;
                const totArm = fue + bla + fis + nes;
                if (totArm > 0) {
                    const elFu = document.getElementById('pctFem_armaFuego');
                    const elBl = document.getElementById('pctFem_armaBlanca');
                    const elFi = document.getElementById('pctFem_fuerzaFisica');
                    const elNe = document.getElementById('pctFem_noEspec');
                    if (elFu) elFu.textContent = ((fue / totArm) * 100).toFixed(1) + '%';
                    if (elBl) elBl.textContent = ((bla / totArm) * 100).toFixed(1) + '%';
                    if (elFi) elFi.textContent = ((fis / totArm) * 100).toFixed(1) + '%';
                    if (elNe) elNe.textContent = ((nes / totArm) * 100).toFixed(1) + '%';
                }

                // 3. AVG
                const cAvg = parseFloat(document.getElementById('numFem_conAvg')?.value) || 0;
                const sAvg = parseFloat(document.getElementById('numFem_sinAvg')?.value) || 0;
                const totAvg = cAvg + sAvg;
                if (totAvg > 0) {
                    const elCA = document.getElementById('pctFem_conAvg');
                    const elSA = document.getElementById('pctFem_sinAvg');
                    if (elCA) elCA.textContent = ((cAvg / totAvg) * 100).toFixed(1) + '%';
                    if (elSA) elSA.textContent = ((sAvg / totAvg) * 100).toFixed(1) + '%';
                }

                // 4. Estado Procesal
                const inv = parseFloat(document.getElementById('numFem_investigacion')?.value) || 0;
                const det = parseFloat(document.getElementById('numFem_detenido')?.value) || 0;
                const pro = parseFloat(document.getElementById('numFem_profugo')?.value) || 0;
                const totProc = inv + det + pro;
                if (totProc > 0) {
                    const elIn = document.getElementById('pctFem_investigacion');
                    const elDe = document.getElementById('pctFem_detenido');
                    const elPr = document.getElementById('pctFem_profugo');
                    if (elIn) elIn.textContent = ((inv / totProc) * 100).toFixed(1) + '%';
                    if (elDe) elDe.textContent = ((det / totProc) * 100).toFixed(1) + '%';
                    if (elPr) elPr.textContent = ((pro / totProc) * 100).toFixed(1) + '%';
                }

                this.actualizarKpis('feminicidios');
            },

            recalcularTalleres() {
                // 1. Modalidades de Formación
                const tal = parseFloat(document.getElementById('numTal_talleres')?.value) || 0;
                const dip = parseFloat(document.getElementById('numTal_diplomados')?.value) || 0;
                const sem = parseFloat(document.getElementById('numTal_seminarios')?.value) || 0;
                const mod = parseFloat(document.getElementById('numTal_modulos')?.value) || 0;
                const totMod = tal + dip + sem + mod;
                if (totMod > 0) {
                    const elTa = document.getElementById('pctTal_talleres');
                    const elDi = document.getElementById('pctTal_diplomados');
                    const elSe = document.getElementById('pctTal_seminarios');
                    const elMo = document.getElementById('pctTal_modulos');
                    if (elTa) elTa.textContent = ((tal / totMod) * 100).toFixed(1) + '%';
                    if (elDi) elDi.textContent = ((dip / totMod) * 100).toFixed(1) + '%';
                    if (elSe) elSe.textContent = ((sem / totMod) * 100).toFixed(1) + '%';
                    if (elMo) elMo.textContent = ((mod / totMod) * 100).toFixed(1) + '%';
                }

                // 2. Participantes Convocadas
                const com = parseFloat(document.getElementById('numTal_mujeresCom')?.value) || 0;
                const est = parseFloat(document.getElementById('numTal_estudiantes')?.value) || 0;
                const fun = parseFloat(document.getElementById('numTal_funcionarias')?.value) || 0;
                const per = parseFloat(document.getElementById('numTal_personal')?.value) || 0;
                const totPar = com + est + fun + per;
                if (totPar > 0) {
                    const elCo = document.getElementById('pctTal_mujeresCom');
                    const elEs = document.getElementById('pctTal_estudiantes');
                    const elFu = document.getElementById('pctTal_funcionarias');
                    const elPe = document.getElementById('pctTal_personal');
                    if (elCo) elCo.textContent = ((com / totPar) * 100).toFixed(1) + '%';
                    if (elEs) elEs.textContent = ((est / totPar) * 100).toFixed(1) + '%';
                    if (elFu) elFu.textContent = ((fun / totPar) * 100).toFixed(1) + '%';
                    if (elPe) elPe.textContent = ((per / totPar) * 100).toFixed(1) + '%';
                }

                // 3. Asistencia y Acreditación
                const asi = parseFloat(document.getElementById('numTal_asistieron')?.value) || 0;
                const prm = parseFloat(document.getElementById('numTal_permisos')?.value) || 0;
                const baj = parseFloat(document.getElementById('numTal_bajas')?.value) || 0;
                const totAsi = asi + prm + baj;
                if (totAsi > 0) {
                    const elAs = document.getElementById('pctTal_asistieron');
                    const elPr = document.getElementById('pctTal_permisos');
                    const elBa = document.getElementById('pctTal_bajas');
                    if (elAs) elAs.textContent = ((asi / totAsi) * 100).toFixed(1) + '%';
                    if (elPr) elPr.textContent = ((prm / totAsi) * 100).toFixed(1) + '%';
                    if (elBa) elBa.textContent = ((baj / totAsi) * 100).toFixed(1) + '%';
                }

                // 4. Ejes Temáticos
                const eVio = parseFloat(document.getElementById('numTal_ejeViolencias')?.value) || 0;
                const eDer = parseFloat(document.getElementById('numTal_ejeDerechos')?.value) || 0;
                const eGen = parseFloat(document.getElementById('numTal_ejeGenero')?.value) || 0;
                const eLid = parseFloat(document.getElementById('numTal_ejeLiderazgo')?.value) || 0;
                const totEjes = eVio + eDer + eGen + eLid;
                if (totEjes > 0) {
                    const elEV = document.getElementById('pctTal_ejeViolencias');
                    const elED = document.getElementById('pctTal_ejeDerechos');
                    const elEG = document.getElementById('pctTal_ejeGenero');
                    const elEL = document.getElementById('pctTal_ejeLiderazgo');
                    if (elEV) elEV.textContent = ((eVio / totEjes) * 100).toFixed(1) + '%';
                    if (elED) elED.textContent = ((eDer / totEjes) * 100).toFixed(1) + '%';
                    if (elEG) elEG.textContent = ((eGen / totEjes) * 100).toFixed(1) + '%';
                    if (elEL) elEL.textContent = ((eLid / totEjes) * 100).toFixed(1) + '%';
                }

                this.actualizarKpis('talleres');
            },

            recalcularProyectos() {
                // 1. Cartera de Proyectos
                const act = parseFloat(document.getElementById('numProy_activos')?.value) || 0;
                const con = parseFloat(document.getElementById('numProy_concluidos')?.value) || 0;
                const ges = parseFloat(document.getElementById('numProy_gestion')?.value) || 0;
                const totProy = act + con + ges;
                if (totProy > 0) {
                    const elAc = document.getElementById('pctProy_activos');
                    const elCo = document.getElementById('pctProy_concluidos');
                    const elGe = document.getElementById('pctProy_gestion');
                    if (elAc) elAc.textContent = ((act / totProy) * 100).toFixed(1) + '%';
                    if (elCo) elCo.textContent = ((con / totProy) * 100).toFixed(1) + '%';
                    if (elGe) elGe.textContent = ((ges / totProy) * 100).toFixed(1) + '%';
                }

                // 2. Fuentes de Financiamiento
                const int = parseFloat(document.getElementById('numProy_internacional')?.value) || 0;
                const pub = parseFloat(document.getElementById('numProy_publicos')?.value) || 0;
                const don = parseFloat(document.getElementById('numProy_donantes')?.value) || 0;
                const totFon = int + pub + don;
                if (totFon > 0) {
                    const elIn = document.getElementById('pctProy_internacional');
                    const elPu = document.getElementById('pctProy_publicos');
                    const elDo = document.getElementById('pctProy_donantes');
                    if (elIn) elIn.textContent = ((int / totFon) * 100).toFixed(1) + '%';
                    if (elPu) elPu.textContent = ((pub / totFon) * 100).toFixed(1) + '%';
                    if (elDo) elDo.textContent = ((don / totFon) * 100).toFixed(1) + '%';
                }

                // 3. Cobertura Comunitaria
                const ben = parseFloat(document.getElementById('numProy_benDirectas')?.value) || 0;
                const mun = parseFloat(document.getElementById('numProy_municipios')?.value) || 0;
                const col = parseFloat(document.getElementById('numProy_colectivas')?.value) || 0;
                const totImp = ben + mun + col;
                if (totImp > 0) {
                    const elBe = document.getElementById('pctProy_benDirectas');
                    const elMu = document.getElementById('pctProy_municipios');
                    const elCo = document.getElementById('pctProy_colectivas');
                    if (elBe) elBe.textContent = ((ben / totImp) * 100).toFixed(1) + '%';
                    if (elMu) elMu.textContent = ((mun / totImp) * 100).toFixed(1) + '%';
                    if (elCo) elCo.textContent = ((col / totImp) * 100).toFixed(1) + '%';
                }

                // 4. Eje de Trabajo
                const eAt = parseFloat(document.getElementById('numProy_ejeAtencion')?.value) || 0;
                const eFo = parseFloat(document.getElementById('numProy_ejeFormacion')?.value) || 0;
                const eMo = parseFloat(document.getElementById('numProy_ejeMonitoreo')?.value) || 0;
                const eGe = parseFloat(document.getElementById('numProy_ejeGestion')?.value) || 0;
                const totEjes = eAt + eFo + eMo + eGe;
                if (totEjes > 0) {
                    const elEA = document.getElementById('pctProy_ejeAtencion');
                    const elEF = document.getElementById('pctProy_ejeFormacion');
                    const elEM = document.getElementById('pctProy_ejeMonitoreo');
                    const elEG = document.getElementById('pctProy_ejeGestion');
                    if (elEA) elEA.textContent = ((eAt / totEjes) * 100).toFixed(1) + '%';
                    if (elEF) elEF.textContent = ((eFo / totEjes) * 100).toFixed(1) + '%';
                    if (elEM) elEM.textContent = ((eMo / totEjes) * 100).toFixed(1) + '%';
                    if (elEG) elEG.textContent = ((eGe / totEjes) * 100).toFixed(1) + '%';
                }

                this.actualizarKpis('proyectos');
            },

            guardarDimension(dim) {
                if (dim === 'salud' && window.datosTematicos && window.datosTematicos.salud) {
                    const s = window.datosTematicos.salud;

                    // Mujeres
                    // 1. Cáncer en Mujeres (5 datos)
                    const cM = parseFloat(document.getElementById('numSalud_cancerMama')?.value) || 1050;
                    const cCv = parseFloat(document.getElementById('numSalud_cancerCerv')?.value) || 250;
                    const cCo = parseFloat(document.getElementById('numSalud_cancerColo')?.value) || 380;
                    const cPu = parseFloat(document.getElementById('numSalud_cancerPulmon')?.value) || 265;
                    const cTi = parseFloat(document.getElementById('numSalud_cancerTiroides')?.value) || 148;
                    const gCanc = s.mujeres?.find(m => m.id === 'canvasMujeresCancer');
                    if (gCanc) {
                        const totCanc = cM + cCv + cCo + cPu + cTi;
                        gCanc.totalDefunciones = 'Total: ' + totCanc.toLocaleString('es-MX') + ' defunciones';
                        gCanc.desgloseTexto = 'Mama: ' + cM.toLocaleString() + ' · Colorrectal: ' + cCo.toLocaleString() + ' · Pulmón: ' + cPu.toLocaleString() + ' · Cervicouterino: ' + cCv.toLocaleString() + ' · Tiroides: ' + cTi.toLocaleString();
                    }

                    // 2. Causas Externas (3 datos)
                    const eAc = parseFloat(document.getElementById('numSalud_externaAccidentes')?.value) || 331;
                    const eHo = parseFloat(document.getElementById('numSalud_externaHomicidio')?.value) || 173;
                    const eSu = parseFloat(document.getElementById('numSalud_externaSuicidio')?.value) || 109;
                    const gExt = s.mujeres?.find(m => m.id === 'canvasMujeresExterna');
                    if (gExt) {
                        const totExt = eAc + eHo + eSu;
                        gExt.totalDefunciones = 'Total: ' + totExt.toLocaleString('es-MX') + ' defunciones';
                        gExt.desgloseTexto = 'Accidentes: ' + eAc.toLocaleString() + ' · Homicidios/Feminicidios: ' + eHo.toLocaleString() + ' · Suicidios: ' + eSu.toLocaleString();
                    }

                    // 3. Mortalidad Materna (3 datos)
                    const emb = parseFloat(document.getElementById('numSalud_embarazo')?.value) || 131;
                    const par = parseFloat(document.getElementById('numSalud_parto')?.value) || 96;
                    const pue = parseFloat(document.getElementById('numSalud_puerperio')?.value) || 77;
                    const gMat = s.mujeres?.find(m => m.id === 'canvasMujeresMaterna');
                    if (gMat) {
                        const totMat = emb + par + pue;
                        gMat.totalDefunciones = 'Total: ' + totMat.toLocaleString('es-MX') + ' defunciones';
                        gMat.desgloseTexto = 'Embarazo / Preeclampsia: ' + emb.toLocaleString() + ' · Parto: ' + par.toLocaleString() + ' · Puerperio / Infección: ' + pue.toLocaleString();
                    }

                    // 4. Diabetes Mellitus (7 datos)
                    const d1 = parseFloat(document.getElementById('numSalud_diabTipo1')?.value) || 76;
                    const d2 = parseFloat(document.getElementById('numSalud_diabTipo2')?.value) || 1097;
                    const dg = parseFloat(document.getElementById('numSalud_diabGest')?.value) || 119;
                    const dm = parseFloat(document.getElementById('numSalud_diabMody')?.value) || 38;
                    const dl = parseFloat(document.getElementById('numSalud_diabLada')?.value) || 82;
                    const di = parseFloat(document.getElementById('numSalud_diabInsipida')?.value) || 23;
                    const ds = parseFloat(document.getElementById('numSalud_diabSec')?.value) || 127;
                    const gDiab = s.mujeres?.find(m => m.id === 'canvasMujeresDiabetes');
                    if (gDiab) {
                        const totDiab = d1 + d2 + dg + dm + dl + di + ds;
                        gDiab.totalDefunciones = 'Total: ' + totDiab.toLocaleString('es-MX') + ' defunciones';
                        gDiab.desgloseTexto = 'Tipo 2: ' + d2.toLocaleString() + ' · Secundaria: ' + ds.toLocaleString() + ' · Gestacional: ' + dg.toLocaleString() + ' · LADA: ' + dl.toLocaleString() + ' · Tipo 1: ' + d1.toLocaleString();
                    }

                    // 5. Cardio Vascular (3 datos)
                    const h = parseFloat(document.getElementById('numSalud_hipertension')?.value) || 787;
                    const inf = parseFloat(document.getElementById('numSalud_infartos')?.value) || 1015;
                    const ins = parseFloat(document.getElementById('numSalud_insuficiencia')?.value) || 600;
                    const gCard = s.mujeres?.find(m => m.id === 'canvasMujeresCardio');
                    if (gCard) {
                        const totCard = h + inf + ins;
                        gCard.totalDefunciones = 'Total: ' + totCard.toLocaleString('es-MX') + ' defunciones';
                        gCard.desgloseTexto = 'Hipertensión: ' + h.toLocaleString() + ' · Infartos: ' + inf.toLocaleString() + ' · Insuficiencia Cardíaca: ' + ins.toLocaleString() + ' defunciones';
                    }

                    // Niñas
                    // 1. Mortalidad <1 (3 datos)
                    const nMal = parseFloat(document.getElementById('numNinas_malformaciones')?.value) || 145;
                    const nCar = parseFloat(document.getElementById('numNinas_cardiacos')?.value) || 200;
                    const nGen = parseFloat(document.getElementById('numNinas_geneticas')?.value) || 87;
                    const gNMor = s.ninas?.find(n => n.id === 'canvasNinasMortalidad');
                    if (gNMor) {
                        const totNMor = nMal + nCar + nGen;
                        gNMor.totalDefunciones = 'Total: ' + totNMor.toLocaleString('es-MX') + ' defunciones';
                        gNMor.desgloseTexto = 'Defectos Cardíacos: ' + nCar.toLocaleString() + ' · Malformaciones: ' + nMal.toLocaleString() + ' · Anomalías Genéticas: ' + nGen.toLocaleString();
                    }

                    // 2. Infecciones (4 datos)
                    const nRe = parseFloat(document.getElementById('numNinas_respiratorias')?.value) || 262;
                    const nDi = parseFloat(document.getElementById('numNinas_diarreas')?.value) || 162;
                    const nMe = parseFloat(document.getElementById('numNinas_meningitis')?.value) || 52;
                    const nSe = parseFloat(document.getElementById('numNinas_sepsis')?.value) || 108;
                    const gNInf = s.ninas?.find(n => n.id === 'canvasNinasInfecciones');
                    if (gNInf) {
                        const totNInf = nRe + nDi + nMe + nSe;
                        gNInf.totalDefunciones = 'Total: ' + totNInf.toLocaleString('es-MX') + ' defunciones';
                        gNInf.desgloseTexto = 'Respiratorias: ' + nRe.toLocaleString() + ' · Diarreas: ' + nDi.toLocaleString() + ' · Sepsis: ' + nSe.toLocaleString() + ' · Meningitis: ' + nMe.toLocaleString() + ' defunciones';
                    }

                    // 3. Desnutrición (3 datos)
                    const nAg = parseFloat(document.getElementById('numNinas_desnAguda')?.value) || 103;
                    const nCr = parseFloat(document.getElementById('numNinas_desnCronica')?.value) || 259;
                    const nMi = parseFloat(document.getElementById('numNinas_micronutrientes')?.value) || 211;
                    const gNDes = s.ninas?.find(n => n.id === 'canvasNinasDesnutricion');
                    if (gNDes) {
                        const totNDes = nAg + nCr + nMi;
                        gNDes.totalDefunciones = 'Total: ' + totNDes.toLocaleString('es-MX') + ' defunciones';
                        gNDes.desgloseTexto = 'Desnutrición Crónica: ' + nCr.toLocaleString() + ' · Micronutrientes: ' + nMi.toLocaleString() + ' · Desnutrición Aguda: ' + nAg.toLocaleString();
                    }

                    // 4. Accidentes y Violencias (4 datos)
                    const nAc = parseFloat(document.getElementById('numNinas_accHogar')?.value) || 165;
                    const nVi = parseFloat(document.getElementById('numNinas_violencia')?.value) || 88;
                    const nAb = parseFloat(document.getElementById('numNinas_abuso')?.value) || 72;
                    const nHo = parseFloat(document.getElementById('numNinas_homicidioSuicidio')?.value) || 37;
                    const gNAcc = s.ninas?.find(n => n.id === 'canvasNinasAccidentes');
                    if (gNAcc) {
                        const totNAcc = nAc + nVi + nAb + nHo;
                        gNAcc.totalDefunciones = 'Total: ' + totNAcc.toLocaleString('es-MX') + ' defunciones';
                        gNAcc.desgloseTexto = 'Accidentes: ' + nAc.toLocaleString() + ' · Violencia física: ' + nVi.toLocaleString() + ' · Abuso: ' + nAb.toLocaleString() + ' · Homicidio/Suicidio: ' + nHo.toLocaleString();
                    }

                    // 5. Consolidado (4 datos)
                    const nCI = parseFloat(document.getElementById('numNinas_consInfecciones')?.value) || 584;
                    const nCD = parseFloat(document.getElementById('numNinas_consDesnutricion')?.value) || 573;
                    const nCM = parseFloat(document.getElementById('numNinas_consMortalidadMenor1')?.value) || 432;
                    const nCV = parseFloat(document.getElementById('numNinas_consViolencias')?.value) || 362;
                    const gNCon = s.ninas?.find(n => n.id === 'canvasNinasConsolidado');
                    if (gNCon) {
                        const totNCon = nCI + nCD + nCM + nCV;
                        gNCon.totalDefunciones = 'Total: ' + totNCon.toLocaleString('es-MX') + ' defunciones';
                        gNCon.desgloseTexto = 'Infecciones: ' + nCI.toLocaleString() + ' · Desnutrición: ' + nCD.toLocaleString() + ' · Mortalidad <1: ' + nCM.toLocaleString() + ' · Violencias: ' + nCV.toLocaleString();
                    }
                }

                if (dim === 'educacion' && window.datosTematicos && window.datosTematicos.educacion) {
                    const e = window.datosTematicos.educacion;
                    // Mujeres
                    // 1. Nivel avanzado
                    const b = parseFloat(document.getElementById('numEdu_bachillerato')?.value) || 207850;
                    const l = parseFloat(document.getElementById('numEdu_licenciatura')?.value) || 139800;
                    const p = parseFloat(document.getElementById('numEdu_posgrado')?.value) || 20100;
                    const gAvan = e.mujeres?.find(m => m.id === 'canvasMujeresNivelAvanzado');
                    if (gAvan) {
                        const tot = b + l + p;
                        gAvan.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' mujeres';
                        gAvan.desgloseTexto = 'Bachillerato: ' + b.toLocaleString() + ' · Licenciatura: ' + l.toLocaleString() + ' · Posgrado: ' + p.toLocaleString() + ' mujeres';
                    }

                    // 2. Fuera del sistema
                    const cui = parseFloat(document.getElementById('numEdu_cuidados')?.value) || 139100;
                    const rec = parseFloat(document.getElementById('numEdu_recursos')?.value) || 111400;
                    const mat = parseFloat(document.getElementById('numEdu_maternidad')?.value) || 76100;
                    const gFuer = e.mujeres?.find(m => m.id === 'canvasMujeresFueraSistema');
                    if (gFuer) {
                        const tot = cui + rec + mat;
                        gFuer.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' mujeres';
                        gFuer.desgloseTexto = 'Cuidados/Hogar: ' + cui.toLocaleString() + ' · Económica: ' + rec.toLocaleString() + ' · Maternidad: ' + mat.toLocaleString();
                    }

                    // 3. STEM y Carreras
                    const c1 = parseFloat(document.getElementById('numEdu_ciencias')?.value) || 3420;
                    const c2 = parseFloat(document.getElementById('numEdu_tecnologia')?.value) || 4180;
                    const c3 = parseFloat(document.getElementById('numEdu_ingenieria')?.value) || 5860;
                    const c4 = parseFloat(document.getElementById('numEdu_matematicas')?.value) || 1890;
                    const c5 = parseFloat(document.getElementById('numEdu_saludEdu')?.value) || 11100;
                    const gStem = e.mujeres?.find(m => m.id === 'canvasMujeresCarreras');
                    if (gStem) {
                        const tot = c1 + c2 + c3 + c4 + c5;
                        gStem.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' alumnas matriculadas';
                        gStem.desgloseTexto = 'Educación y Salud: ' + c5.toLocaleString() + ' · Ingeniería: ' + c3.toLocaleString() + ' · Tecnología/TIC: ' + c2.toLocaleString() + ' · Ciencias: ' + c1.toLocaleString() + ' · Matemáticas: ' + c4.toLocaleString();
                        if (gStem.datasets && gStem.datasets[0]) {
                            gStem.datasets[0].data = [c1, c2, c3, c4, c5];
                        }
                    }

                    // 4. Analfabetismo
                    const ind = parseFloat(document.getElementById('numEdu_analfIndigena')?.value) || 200000;
                    const noInd = parseFloat(document.getElementById('numEdu_analfNoIndigena')?.value) || 42160;
                    const gAnalf = e.mujeres?.find(m => m.id === 'canvasMujeresAnalfabetas');
                    if (gAnalf) {
                        const tot = ind + noInd;
                        gAnalf.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' analfabetas';
                    }

                    // Niñas
                    // 1. Acceso y permanencia
                    const nInsc = parseFloat(document.getElementById('numEduNinas_inscritas')?.value) || 396250;
                    const nNoAs = parseFloat(document.getElementById('numEduNinas_noAsisten')?.value) || 51570;
                    const nAban = parseFloat(document.getElementById('numEduNinas_abandono')?.value) || 19360;
                    const gNAcc = e.ninas?.find(n => n.id === 'canvasNinasAccesoEdu');
                    if (gNAcc) {
                        const tot = nInsc + nNoAs + nAban;
                        gNAcc.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' niñas';
                        gNAcc.desgloseTexto = 'Inscritas: ' + nInsc.toLocaleString() + ' · No Asisten: ' + nNoAs.toLocaleString() + ' · Abandono: ' + nAban.toLocaleString();
                    }

                    // 2. Alfabetización Niñas
                    const nLeer = parseFloat(document.getElementById('numEduNinas_sabenLeer')?.value) || 285500;
                    const nNoLeer = parseFloat(document.getElementById('numEduNinas_noSabenLeer')?.value) || 30350;
                    const nProc = parseFloat(document.getElementById('numEduNinas_proceso')?.value) || 27400;
                    const gNAlf = e.ninas?.find(n => n.id === 'canvasNinasAlfabetizacion');
                    if (gNAlf) {
                        gNAlf.totalDefunciones = 'Total: ' + nLeer.toLocaleString('es-MX') + ' niñas alfabetas';
                        gNAlf.desgloseTexto = 'Saben Leer/Escribir: ' + nLeer.toLocaleString() + ' · No Saben: ' + nNoLeer.toLocaleString() + ' · En Proceso: ' + nProc.toLocaleString();
                    }

                    // 3. Niñas Fuera del Sistema
                    const nRec = parseFloat(document.getElementById('numEduNinas_faltaRecursos')?.value) || 22000;
                    const nCui = parseFloat(document.getElementById('numEduNinas_cuidados')?.value) || 18300;
                    const nLej = parseFloat(document.getElementById('numEduNinas_lejania')?.value) || 10900;
                    const nTra = parseFloat(document.getElementById('numEduNinas_trabajoInfantil')?.value) || 5370;
                    const gNFuer = e.ninas?.find(n => n.id === 'canvasNinasFueraSistema');
                    if (gNFuer) {
                        const tot = nRec + nCui + nLej + nTra;
                        gNFuer.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' niñas';
                        gNFuer.desgloseTexto = 'Falta Recursos: ' + nRec.toLocaleString() + ' · Cuidados en Hogar: ' + nCui.toLocaleString() + ' · Lejanía: ' + nLej.toLocaleString() + ' · Trabajo Infantil: ' + nTra.toLocaleString();
                    }

                    // 4. Consolidado Escolar Niñas
                    const cPrim = parseFloat(document.getElementById('numEduNinas_concluyenPrimaria')?.value) || 89.6;
                    const cSec = parseFloat(document.getElementById('numEduNinas_ingresanSecundaria')?.value) || 78.4;
                    const cRez = parseFloat(document.getElementById('numEduNinas_rezago')?.value) || 16.2;
                    const cDes = parseFloat(document.getElementById('numEduNinas_desercion')?.value) || 8.4;
                    const gNCons = e.ninas?.find(n => n.id === 'canvasNinasConsolidadoEdu');
                    if (gNCons) {
                        gNCons.desgloseTexto = 'Concluyen Primaria: ' + cPrim.toFixed(1) + '% · Ingresan Secundaria: ' + cSec.toFixed(1) + '% · Rezago: ' + cRez.toFixed(1) + '% · Deserción Temprana: ' + cDes.toFixed(1) + '%';
                        if (gNCons.datasets && gNCons.datasets[0]) {
                            gNCons.datasets[0].data = [cPrim, cSec, cRez, cDes];
                        }
                    }
                }

                if (dim === 'vivienda' && window.datosTematicos && window.datosTematicos.vivienda) {
                    const v = window.datosTematicos.vivienda;
                    // Columna Izquierda: Tenencia y Hacinamiento
                    const pProp = parseFloat(document.getElementById('numViv_propia')?.value) || 335503;
                    const pRent = parseFloat(document.getElementById('numViv_rentan')?.value) || 128347;
                    const pPres = parseFloat(document.getElementById('numViv_prestada')?.value) || 204905;
                    const pEjid = parseFloat(document.getElementById('numViv_ejidal')?.value) || 188016;
                    const gTen = v.columnaIzquierda?.find(c => c.id === 'canvasViviendaTenencia');
                    if (gTen) {
                        gTen.desgloseTexto = 'Propia Mujeres: ' + pProp.toLocaleString() + ' · Rentan: ' + pRent.toLocaleString() + ' · Sin Título/Prestada: ' + pPres.toLocaleString() + ' · Ejidal: ' + pEjid.toLocaleString();
                        if (gTen.datasets && gTen.datasets[1]) {
                            gTen.datasets[1].data = [pProp, pRent, pPres, pEjid];
                        }
                    }

                    const hHac = parseFloat(document.getElementById('numViv_hacinamiento')?.value) || 55985;
                    const hCua = parseFloat(document.getElementById('numViv_unCuarto')?.value) || 80950;
                    const hBan = parseFloat(document.getElementById('numViv_sinBano')?.value) || 98350;
                    const hEsc = parseFloat(document.getElementById('numViv_sinEscrituras')?.value) || 63172;
                    const gHac = v.columnaIzquierda?.find(c => c.id === 'canvasViviendaHacinamiento');
                    if (gHac) {
                        gHac.desgloseTexto = 'Hacinamiento: ' + hHac.toLocaleString() + ' · Un Solo Cuarto: ' + hCua.toLocaleString() + ' · Sin Baño Exclusivo: ' + hBan.toLocaleString() + ' · Sin Escrituras: ' + hEsc.toLocaleString();
                        if (gHac.datasets && gHac.datasets[0]) {
                            gHac.datasets[0].data = [hHac, hCua, hBan, hEsc];
                        }
                    }

                    // Columna Derecha: Servicios Básicos y Materiales
                    const sAgua = parseFloat(document.getElementById('numViv_agua')?.value) || 689020;
                    const sDren = parseFloat(document.getElementById('numViv_drenaje')?.value) || 703656;
                    const sLuz = parseFloat(document.getElementById('numViv_luz')?.value) || 1096577;
                    const sPav = parseFloat(document.getElementById('numViv_pavimento')?.value) || 542660;
                    const gServ = v.columnaDerecha?.find(c => c.id === 'canvasViviendaServicios');
                    if (gServ) {
                        gServ.desgloseTexto = 'Agua: ' + sAgua.toLocaleString() + ' cuentan · Drenaje: ' + sDren.toLocaleString() + ' · Electricidad: ' + sLuz.toLocaleString() + ' · Pavimentación: ' + sPav.toLocaleString();
                        if (gServ.datasets && gServ.datasets[0]) {
                            gServ.datasets[0].data = [sAgua, sDren, sLuz, sPav];
                        }
                        if (gServ.datasets && gServ.datasets[1]) {
                            gServ.datasets[1].data = [1125849 - sAgua, 1125849 - sDren, 1125849 - sLuz, 1125849 - sPav];
                        }
                    }

                    const mLam = parseFloat(document.getElementById('numViv_techoLamina')?.value) || 409809;
                    const mTie = parseFloat(document.getElementById('numViv_pisoTierra')?.value) || 76558;
                    const mMuro = parseFloat(document.getElementById('numViv_murosPrecarios')?.value) || 319741;
                    const gMat = v.columnaDerecha?.find(c => c.id === 'canvasViviendaMateriales');
                    if (gMat) {
                        gMat.desgloseTexto = 'Techo Lámina: ' + mLam.toLocaleString() + ' · Piso Tierra: ' + mTie.toLocaleString() + ' · Muros Precarios: ' + mMuro.toLocaleString() + ' viviendas';
                        if (gMat.datasets && gMat.datasets[0]) {
                            gMat.datasets[0].data = [mLam, mTie, mMuro];
                        }
                        if (gMat.datasets && gMat.datasets[1]) {
                            gMat.datasets[1].data = [1125849 - mLam, 1125849 - mTie, 1125849 - mMuro];
                        }
                    }
                }

                if (dim === 'ingreso' && window.datosTematicos && window.datosTematicos.ingreso) {
                    const ing = window.datosTematicos.ingreso;
                    // Columna Izquierda: Formalidad y No Formal
                    const f = parseFloat(document.getElementById('numIng_formal')?.value) || 139650;
                    const i = parseFloat(document.getElementById('numIng_informal')?.value) || 603200;
                    const gForm = ing.columnaIzquierda?.find(c => c.id === 'canvasIngresoFormalidad');
                    if (gForm) {
                        const tot = f + i;
                        gForm.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' ocupadas en Oaxaca';
                        gForm.desgloseTexto = 'No Formal (Informal): ' + i.toLocaleString() + ' mujeres · Formal: ' + f.toLocaleString() + ' mujeres';
                        if (gForm.datasets && gForm.datasets[0]) {
                            gForm.datasets[0].data = [f, i];
                        }
                    }

                    const mAmb = parseFloat(document.getElementById('numIng_ambulante')?.value) || 219560;
                    const mDom = parseFloat(document.getElementById('numIng_domestico')?.value) || 149600;
                    const mAut = parseFloat(document.getElementById('numIng_autoempleo')?.value) || 136320;
                    const mJor = parseFloat(document.getElementById('numIng_jornaleras')?.value) || 97720;
                    const gNoF = ing.columnaIzquierda?.find(c => c.id === 'canvasIngresoNoFormal');
                    if (gNoF) {
                        const tot = mAmb + mDom + mAut + mJor;
                        gNoF.totalDefunciones = 'Total: ' + tot.toLocaleString('es-MX') + ' trabajadoras';
                        gNoF.desgloseTexto = 'Ambulante: ' + mAmb.toLocaleString() + ' · Doméstico: ' + mDom.toLocaleString() + ' · Autoempleo: ' + mAut.toLocaleString() + ' · Jornal: ' + mJor.toLocaleString();
                        if (gNoF.datasets && gNoF.datasets[0]) {
                            gNoF.datasets[0].data = [mAmb, mDom, mAut, mJor];
                        }
                    }

                    // Columna Derecha: Salarios y Remesas
                    const pSin = parseFloat(document.getElementById('numIng_sinPrestaciones')?.value) || 582395;
                    const pAgu = parseFloat(document.getElementById('numIng_aguinaldo')?.value) || 160455;
                    const pVac = parseFloat(document.getElementById('numIng_vacaciones')?.value) || 151540;
                    const pSeg = parseFloat(document.getElementById('numIng_seguridadSocial')?.value) || 139650;
                    const gSal = ing.columnaDerecha?.find(c => c.id === 'canvasIngresoSalarios');
                    if (gSal) {
                        gSal.desgloseTexto = 'Sin Prestaciones: ' + pSin.toLocaleString() + ' · Con Aguinaldo: ' + pAgu.toLocaleString() + ' · Vacaciones: ' + pVac.toLocaleString() + ' · IMSS/ISSSTE: ' + pSeg.toLocaleString();
                        if (gSal.datasets && gSal.datasets[0]) {
                            gSal.datasets[0].data = [pSin, pAgu, pVac, pSeg];
                        }
                    }

                    const rHog = parseFloat(document.getElementById('numIng_hogaresRemesas')?.value) || 92206;
                    const rAli = parseFloat(document.getElementById('numIng_gastoAlimentos')?.value) || 206980;
                    const rSal = parseFloat(document.getElementById('numIng_gastoSalud')?.value) || 59644;
                    const rEdu = parseFloat(document.getElementById('numIng_gastoEducacion')?.value) || 38043;
                    const gRem = ing.columnaDerecha?.find(c => c.id === 'canvasIngresoRemesas');
                    if (gRem) {
                        gRem.desgloseTexto = 'Receptores de Remesas: ' + rHog.toLocaleString() + ' · Gasto Alimentos: ' + rAli.toLocaleString() + ' · Salud: ' + rSal.toLocaleString() + ' · Educación: ' + rEdu.toLocaleString();
                        if (gRem.datasets && gRem.datasets[0]) {
                            gRem.datasets[0].data = [rHog, rAli, rSal, rEdu];
                        }
                    }
                }

                if (dim === 'psicologia' && window.datosTematicos && window.datosTematicos.psicologia) {
                    const p = window.datosTematicos.psicologia;
                    const ini = parseFloat(document.getElementById('numPsic_inicial')?.value) || 345;
                    const con = parseFloat(document.getElementById('numPsic_continua')?.value) || 520;
                    const urg = parseFloat(document.getElementById('numPsic_urgencia')?.value) || 180;
                    const can = parseFloat(document.getElementById('numPsic_canalizacion')?.value) || 95;
                    const totSes = ini + con + urg + can;
                    if (p.kpiTotal) p.kpiTotal.valor = totSes.toLocaleString('es-MX');
                    if (p.graficaPrincipal && p.graficaPrincipal.datasets && p.graficaPrincipal.datasets[0]) {
                        p.graficaPrincipal.datasets[0].data = [ini, con, urg, can];
                    }
                    const vP = parseFloat(document.getElementById('numPsic_violenciaPsic')?.value) || 410;
                    const ans = parseFloat(document.getElementById('numPsic_ansiedad')?.value) || 320;
                    const due = parseFloat(document.getElementById('numPsic_duelo')?.value) || 230;
                    const tra = parseFloat(document.getElementById('numPsic_trauma')?.value) || 180;
                    if (p.graficaSecundaria && p.graficaSecundaria.datasets && p.graficaSecundaria.datasets[0]) {
                        p.graficaSecundaria.datasets[0].data = [vP, ans, due, tra];
                    }
                }

                if (dim === 'juicios' && window.datosTematicos && window.datosTematicos.juicios) {
                    const j = window.datosTematicos.juicios;
                    const ase = parseFloat(document.getElementById('numJui_asesorias')?.value) || 280;
                    const aud = parseFloat(document.getElementById('numJui_audiencias')?.value) || 195;
                    const car = parseFloat(document.getElementById('numJui_carpetas')?.value) || 140;
                    const tel = parseFloat(document.getElementById('numJui_telefonicas')?.value) || 85;
                    const totServ = ase + aud + car + tel;
                    if (j.kpiTotal) j.kpiTotal.valor = totServ.toLocaleString('es-MX');
                    const pen = parseFloat(document.getElementById('numJui_pension')?.value) || 260;
                    const cus = parseFloat(document.getElementById('numJui_custodia')?.value) || 210;
                    const div = parseFloat(document.getElementById('numJui_divorcio')?.value) || 145;
                    const ord = parseFloat(document.getElementById('numJui_ordenes')?.value) || 85;
                    if (j.graficaPrincipal && j.graficaPrincipal.datasets && j.graficaPrincipal.datasets[0]) {
                        j.graficaPrincipal.datasets[0].data = [pen, cus, div, ord];
                    }
                    const sen = parseFloat(document.getElementById('numJui_sentencia')?.value) || 185;
                    const act = parseFloat(document.getElementById('numJui_activo')?.value) || 310;
                    const conv = parseFloat(document.getElementById('numJui_convenios')?.value) || 130;
                    const cnc = parseFloat(document.getElementById('numJui_concluidos')?.value) || 75;
                    if (j.graficaSecundaria && j.graficaSecundaria.datasets && j.graficaSecundaria.datasets[0]) {
                        j.graficaSecundaria.datasets[0].data = [sen, act, con, cnc];
                    }
                }

                if (dim === 'atendidas' && window.datosTematicos && window.datosTematicos.atendidas) {
                    const a = window.datosTematicos.atendidas;
                    const adu = parseFloat(document.getElementById('numAten_adultas')?.value) || 890;
                    const adl = parseFloat(document.getElementById('numAten_adolescentes')?.value) || 245;
                    const tut = parseFloat(document.getElementById('numAten_tutoras')?.value) || 160;
                    const inf = parseFloat(document.getElementById('numAten_infantes')?.value) || 125;
                    const totUsu = adu + adl + tut + inf;
                    if (a.kpiTotal) a.kpiTotal.valor = totUsu.toLocaleString('es-MX');
                    const vPs = parseFloat(document.getElementById('numAten_vPsic')?.value) || 610;
                    const vFi = parseFloat(document.getElementById('numAten_vFis')?.value) || 340;
                    const vEc = parseFloat(document.getElementById('numAten_vEcon')?.value) || 280;
                    const vSe = parseFloat(document.getElementById('numAten_vSex')?.value) || 190;
                    if (a.graficaPrincipal && a.graficaPrincipal.datasets && a.graficaPrincipal.datasets[0]) {
                        a.graficaPrincipal.datasets[0].data = [vPs, vFi, vEc, vSe];
                    }
                    const rVal = parseFloat(document.getElementById('numAten_regValles')?.value) || 620;
                    const rIst = parseFloat(document.getElementById('numAten_regIstmo')?.value) || 290;
                    const rCos = parseFloat(document.getElementById('numAten_regCosta')?.value) || 230;
                    const rSie = parseFloat(document.getElementById('numAten_regSierras')?.value) || 180;
                    const rNor = parseFloat(document.getElementById('numAten_regNorte')?.value) || 100;
                    if (a.graficaSecundaria && a.graficaSecundaria.datasets && a.graficaSecundaria.datasets[0]) {
                        a.graficaSecundaria.datasets[0].data = [rVal, rIst, rCos, rSie, rNor];
                    }
                }

                if (dim === 'feminicidios' && window.datosTematicos && window.datosTematicos.feminicidios) {
                    const f = window.datosTematicos.feminicidios;
                    const ist = parseFloat(document.getElementById('numFem_istmo')?.value) || 38;
                    const val = parseFloat(document.getElementById('numFem_valles')?.value) || 32;
                    const cos = parseFloat(document.getElementById('numFem_costa')?.value) || 29;
                    const sur = parseFloat(document.getElementById('numFem_sierraSur')?.value) || 21;
                    const mix = parseFloat(document.getElementById('numFem_mixteca')?.value) || 14;
                    const otr = parseFloat(document.getElementById('numFem_otrasReg')?.value) || 20;
                    const totFem = ist + val + cos + sur + mix + otr;
                    if (f.kpiTotal) f.kpiTotal.valor = totFem.toLocaleString('es-MX');
                    if (f.graficaPrincipal && f.graficaPrincipal.datasets && f.graficaPrincipal.datasets[0]) {
                        f.graficaPrincipal.datasets[0].data = [ist, val, cos, sur, mix, otr];
                    }
                    const inv = parseFloat(document.getElementById('numFem_investigacion')?.value) || 128;
                    const det = parseFloat(document.getElementById('numFem_detenido')?.value) || 18;
                    const pro = parseFloat(document.getElementById('numFem_profugo')?.value) || 8;
                    if (f.graficaSecundaria && f.graficaSecundaria.datasets && f.graficaSecundaria.datasets[0]) {
                        f.graficaSecundaria.datasets[0].data = [inv, det, pro];
                    }
                }

                if (dim === 'talleres' && window.datosTematicos && window.datosTematicos.talleres) {
                    const t = window.datosTematicos.talleres;
                    const tal = parseFloat(document.getElementById('numTal_talleres')?.value) || 48;
                    const dip = parseFloat(document.getElementById('numTal_diplomados')?.value) || 12;
                    const sem = parseFloat(document.getElementById('numTal_seminarios')?.value) || 16;
                    const mod = parseFloat(document.getElementById('numTal_modulos')?.value) || 64;
                    const totEve = tal + dip + sem + mod;
                    if (t.kpiTotal) t.kpiTotal.valor = totEve.toLocaleString('es-MX');
                    if (t.graficaPrincipal && t.graficaPrincipal.datasets && t.graficaPrincipal.datasets[0]) {
                        t.graficaPrincipal.datasets[0].data = [tal, dip, sem, mod];
                    }
                    const eVio = parseFloat(document.getElementById('numTal_ejeViolencias')?.value) || 46;
                    const eDer = parseFloat(document.getElementById('numTal_ejeDerechos')?.value) || 38;
                    const eGen = parseFloat(document.getElementById('numTal_ejeGenero')?.value) || 28;
                    const eLid = parseFloat(document.getElementById('numTal_ejeLiderazgo')?.value) || 28;
                    if (t.graficaSecundaria && t.graficaSecundaria.datasets && t.graficaSecundaria.datasets[0]) {
                        t.graficaSecundaria.datasets[0].data = [eVio, eDer, eGen, eLid];
                    }
                }

                if (dim === 'proyectos' && window.datosTematicos && window.datosTematicos.proyectos) {
                    const pr = window.datosTematicos.proyectos;
                    const act = parseFloat(document.getElementById('numProy_activos')?.value) || 8;
                    const con = parseFloat(document.getElementById('numProy_concluidos')?.value) || 14;
                    const ges = parseFloat(document.getElementById('numProy_gestion')?.value) || 5;
                    const totProy = act + con + ges;
                    if (pr.kpiTotal) pr.kpiTotal.valor = totProy.toLocaleString('es-MX');
                    const int = parseFloat(document.getElementById('numProy_internacional')?.value) || 4250000;
                    const pub = parseFloat(document.getElementById('numProy_publicos')?.value) || 2800000;
                    const don = parseFloat(document.getElementById('numProy_donantes')?.value) || 950000;
                    if (pr.graficaPrincipal && pr.graficaPrincipal.datasets && pr.graficaPrincipal.datasets[0]) {
                        pr.graficaPrincipal.datasets[0].data = [int, pub, don];
                    }
                    const eAt = parseFloat(document.getElementById('numProy_ejeAtencion')?.value) || 38;
                    const eFo = parseFloat(document.getElementById('numProy_ejeFormacion')?.value) || 32;
                    const eMo = parseFloat(document.getElementById('numProy_ejeMonitoreo')?.value) || 18;
                    const eGe = parseFloat(document.getElementById('numProy_ejeGestion')?.value) || 12;
                    if (pr.graficaSecundaria && pr.graficaSecundaria.datasets && pr.graficaSecundaria.datasets[0]) {
                        pr.graficaSecundaria.datasets[0].data = [eAt, eFo, eMo, eGe];
                    }
                }
                const toast = document.getElementById('adminToastAuto');
                const texto = document.getElementById('adminToastAutoTexto');
                if (texto) texto.textContent = '¡Cambios en ' + dim.toUpperCase() + ' guardados con éxito!';
                if (toast) {
                    toast.classList.remove('d-none');
                    setTimeout(() => toast.classList.add('d-none'), 3500);
                }
            }
        };

        // Escuchadores automáticos en inputs territoriales para sincronizar las 3 KPI cards en vivo
        ['inputNacPob', 'inputNacMujeres', 'inputNacHombres'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', () => AdminMenuDashboard.actualizarKpis('nacional'));
        });
        ['inputEstPob', 'inputEstMujeres', 'inputEstHombres'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', () => AdminMenuDashboard.actualizarKpis('estatal'));
        });
        ['inputRegPob', 'inputRegMujeres', 'inputRegHombres'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', () => AdminMenuDashboard.actualizarKpis('regional'));
        });

        // Sincronización al abrir el modal de administración
        document.addEventListener('DOMContentLoaded', () => {
            const modalAdminEl = document.getElementById('modalAdmin');
            if (modalAdminEl) {
                modalAdminEl.addEventListener('show.bs.modal', () => {
                    sessionStorage.setItem('plataforma_admin_sesion_activa', 'true');
                    try {
                        history.replaceState(null, document.title, '#admin');
                    } catch(e) {}
                });
                modalAdminEl.addEventListener('shown.bs.modal', () => {
                    // CORRECCIÓN: Forzar siempre la vista de inicio al abrir el panel
                    const catGuardada = sessionStorage.getItem('plataforma_admin_categoria');
                    AdminMenuDashboard.seleccionar(catGuardada || 'inicio');
                });
                modalAdminEl.addEventListener('hidden.bs.modal', () => {
                    sessionStorage.removeItem('plataforma_admin_sesion_activa');
                    sessionStorage.removeItem('plataforma_admin_categoria');
                    try {
                        if (window.location.hash === '#admin') {
                            history.replaceState(null, document.title, window.location.pathname + window.location.search);
                        }
                    } catch(e) {}
                });
            }
        });
    </script>

<script>
        let miGrafica = null;
        let mapaLeaflet = null;
        let temaActual = 'poblacion';
        let estadoSeleccionado = null;
        let ambitoActual = 'ESTATAL';

     function crearOpcionesBarras(titleY, colorX) {
    return {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            datalabels: {
                anchor: 'end',
                align: 'end',
                color: '#333',
                font: { weight: 'bold', size: 10 },
                formatter: function(value) {
                    if (!value && value !== 0) return '';
                    return Number(value).toLocaleString('es-MX');
                },
                clip: false
            },
            tooltip: {
                callbacks: {
                    label: function(c) {
                        return ' ' + Number(c.raw).toLocaleString('es-MX') + ' hab.';
                    }
                }
            }
        },
        layout: { padding: { top: 24, bottom: 10 } },
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    callback: function(v) {
                        return v >= 1000000 ? (v / 1000000).toFixed(1) + 'M'
                             : v >= 1000 ? (v / 1000).toFixed(0) + 'K' : v;
                    },
                    font: { size: 10 }
                },
                title: { display: true, text: titleY || 'Habitantes', font: { size: 11, weight: 'bold' } },
                grid: { color: 'rgba(0,0,0,0.05)' }
            },
            x: {
                ticks: { 
                    font: { size: 9, weight: 'bold' },
                    color: colorX || '#4a154b', 
                    maxRotation: 0,
                    minRotation: 0,
                    autoSkip: false,
                    padding: 5
                },
                grid: { display: false }
            }
        }
    };
}
        const regionesOaxacaCoordenadas = [
            { id: 1, clave: 'REG-01', nombre: 'Valles C', lat: 17.0732, lng: -96.7266, pob: '1,033,884', mujeresHab: '549,000', hombresHab: '484,884', mujeres: '53.1%', hombres: '46.9%', psic: 1147, juicios: 598, casos: 420 },
            { id: 2, clave: 'REG-02', nombre: 'Istmo', lat: 16.4360, lng: -95.2400, pob: '622,464', mujeresHab: '322,000', hombresHab: '300,464', mujeres: '51.7%', hombres: '48.3%', psic: 185, juicios: 120, casos: 198 },
            { id: 3, clave: 'REG-03', nombre: 'Tuxtepec', lat: 18.1000, lng: -96.1000, pob: '492,028', mujeresHab: '257,000', hombresHab: '235,028', mujeres: '52.2%', hombres: '47.8%', psic: 92, juicios: 45, casos: 99 },
            { id: 4, clave: 'REG-04', nombre: 'Costa', lat: 15.8500, lng: -96.3200, pob: '597,975', mujeresHab: '309,000', hombresHab: '288,975', mujeres: '51.7%', hombres: '48.3%', psic: 148, juicios: 74, casos: 165 },
            { id: 5, clave: 'REG-05', nombre: 'Mixteca', lat: 17.5000, lng: -97.5000, pob: '483,163', mujeresHab: '258,000', hombresHab: '225,163', mujeres: '53.4%', hombres: '46.6%', psic: 142, juicios: 82, casos: 121 },
            { id: 6, clave: 'REG-06', nombre: 'Sierra S', lat: 16.2000, lng: -96.5000, pob: '341,202', mujeresHab: '177,000', hombresHab: '164,202', mujeres: '51.9%', hombres: '48.1%', psic: 74, juicios: 38, casos: 55 },
            { id: 7, clave: 'REG-07', nombre: 'Sierra N', lat: 17.5000, lng: -96.3000, pob: '181,048', mujeresHab: '94,000', hombresHab: '87,048', mujeres: '51.9%', hombres: '48.1%', psic: 37, juicios: 18, casos: 44 },
            { id: 8, clave: 'REG-08', nombre: 'Cañada', lat: 17.8000, lng: -96.8000, pob: '179,384', mujeresHab: '93,000', hombresHab: '86,384', mujeres: '51.8%', hombres: '48.2%', psic: 25, juicios: 15, casos: 33 }
        ];

        let timerBotonTerritorial = null;
        function cambiarAmbito(ambito, elemento) {
            ambitoActual = ambito;
            try {
                sessionStorage.setItem('plataforma_vista_activa', JSON.stringify({ tipo: 'territorial', id: ambito }));
                history.replaceState(null, document.title, '#' + ambito.toLowerCase());
            } catch(e) {}

            document.querySelectorAll(".btn-territorial").forEach(btn => {
                btn.classList.remove("active");
                btn.blur();
            });

            if (elemento) {
                elemento.classList.add("active");
                if (timerBotonTerritorial) {
                    clearTimeout(timerBotonTerritorial);
                }
                timerBotonTerritorial = setTimeout(function() {
                    if (elemento) {
                        elemento.classList.remove("active");
                        elemento.blur();
                    }
                }, 1600);
            }

            if (ambito === "NACIONAL") {
                abrirVentanaNacional();
            } else if (ambito === "ESTATAL") {
                abrirVentanaEstatal();
            }
        }

        function configurarAutoCierrePopup(mapa) {
            if (!mapa) return;
            mapa.on('popupopen', function (e) {
                const popup = e.popup;
                if (popup && popup._timerAutoCierre) {
                    clearTimeout(popup._timerAutoCierre);
                }
                if (popup) {
                    popup._timerAutoCierre = setTimeout(function () {
                        if (mapa && popup && mapa.hasLayer(popup)) {
                            mapa.closePopup(popup);
                        }
                    }, 4500);
                }
            });
        }

        let modalNacionalBootstrap = null;
        let mapaMexicoLeaflet = null;
        let chartPoblacionNacional = null;

        function abrirVentanaNacional() {
            const modalEl = document.getElementById('modalNacional');
            if (!modalEl) return;

            if (!modalNacionalBootstrap) {
                modalNacionalBootstrap = new bootstrap.Modal(modalEl);
                modalEl.addEventListener('shown.bs.modal', function () {
                    inicializarMapaMexico();
                    renderizarGraficaNacional();
                    if (mapaMexicoLeaflet) {
                        mapaMexicoLeaflet.closePopup();
                        mapaMexicoLeaflet.invalidateSize();
                    }
                });
                modalEl.addEventListener('hidden.bs.modal', function () {
                    if (mapaMexicoLeaflet) {
                        mapaMexicoLeaflet.closePopup();
                    }
                });
            } else {
                if (mapaMexicoLeaflet) {
                    mapaMexicoLeaflet.closePopup();
                }
            }
            modalNacionalBootstrap.show();
        }

        function inicializarMapaMexico() {
            if (!mapaMexicoLeaflet) {
                mapaMexicoLeaflet = L.map('mapaMexico').setView([23.6345, -102.5528], 5);
                configurarAutoCierrePopup(mapaMexicoLeaflet);

                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                    attribution: '&copy; Esri | INEGI Censo 2020',
                    maxZoom: 18
                }).addTo(mapaMexicoLeaflet);

                if (typeof geojsonEstadosMexico !== 'undefined') {
                    L.geoJSON(geojsonEstadosMexico, {
                        style: function (feature) {
                            return {
                                color: '#682260',
                                weight: 1.5,
                                fillColor: '#f3e8f1',
                                fillOpacity: 0.25
                            };
                        },
                    
                        onEachFeature: function (feature, layer) {
                            const nombreRaw = (feature.properties && feature.properties.name) ? feature.properties.name : "Entidad Federativa";
                            
                            layer.bindPopup(function() {
                                return AdminDatos.generarHtmlPopupEstado(nombreRaw);
                            });

                            layer.on('mouseover', function () {
                                if (this !== estadoSeleccionado) {
                                    this.setStyle({ weight: 3, fillOpacity: 0.65 });
                                }
                            });

                            layer.on('mouseout', function () {
                                if (this !== estadoSeleccionado) {
                                    this.setStyle({ weight: 1.5, fillOpacity: 0.25 });
                                }
                            });

                            layer.on('click', function () {
                                if (estadoSeleccionado && estadoSeleccionado !== this) {
                                    estadoSeleccionado.setStyle({
                                        color: '#682260',
                                        weight: 1.5,
                                        fillColor: '#f3e8f1',
                                        fillOpacity: 0.25
                                    });
                                }
                                this.setStyle({ weight: 3, fillColor: '#c2185b', fillOpacity: 0.45 });
                                estadoSeleccionado = this;

                                if (mapaMexicoLeaflet) mapaMexicoLeaflet.closePopup();
                                actualizarPanelEstadoNacional(nombreRaw);
                            });
                        }
                    }).addTo(mapaMexicoLeaflet);
                }
            }
        }

        function actualizarKpisNacional() {
            if (!window.AdminDatos) return;
            const nac = AdminDatos.getNacional();
            const elTot = document.getElementById('kpiNacionalTotal');
            const elMuj = document.getElementById('kpiNacionalMujeres');
            const elPctM = document.getElementById('kpiNacionalPctMujeres');
            const elHom = document.getElementById('kpiNacionalHombres');
            const elPctH = document.getElementById('kpiNacionalPctHombres');

            if (elTot) elTot.textContent = nac.pobFormateada;
            if (elMuj) elMuj.textContent = nac.mujeresFormateada;
            if (elPctM) elPctM.textContent = nac.pctMujeres + ' del total';
            if (elHom) elHom.textContent = nac.hombresFormateada;
            if (elPctH) elPctH.textContent = nac.pctHombres + ' del total';
        }

        function actualizarPanelEstadoNacional(nombreEstado) {
            if (!window.AdminDatos) return;

            var est = AdminDatos.getEstado(nombreEstado);

            const titulo = document.getElementById('tituloPanelNacional');
            const subtitulo = document.getElementById('subtituloPanelNacional');
            const labelTotal = document.getElementById('labelNacionalTotal');
            const iconoWrapper = document.getElementById('iconoPanelNacional');
            const elTot = document.getElementById('kpiNacionalTotal');
            const elMuj = document.getElementById('kpiNacionalMujeres');
            const elPctM = document.getElementById('kpiNacionalPctMujeres');
            const elHom = document.getElementById('kpiNacionalHombres');
            const elPctH = document.getElementById('kpiNacionalPctHombres');
            const btnWrap = document.getElementById('btnVolverMexicoWrap');

            if (titulo) titulo.textContent = nombreEstado.toUpperCase();
            if (subtitulo) subtitulo.textContent = 'Datos demográficos · INEGI Censo 2020';
            if (labelTotal) labelTotal.textContent = 'Población Total';
            if (iconoWrapper) iconoWrapper.innerHTML = '<i class="fa-solid fa-location-dot"></i>';
            if (btnWrap) btnWrap.style.display = '';

            var pobNum = 0, mujNum = 0, homNum = 0, pctM = '--', pctH = '--';

            if (est) {
                pobNum = Number(est.pob) || 0;
                mujNum = Number(est.mujeres) || 0;
                homNum = Number(est.hombres) || 0;
                pctM = est.pctMujeres || (pobNum > 0 ? ((mujNum / pobNum) * 100).toFixed(1) + '%' : '--');
                pctH = est.pctHombres || (pobNum > 0 ? ((homNum / pobNum) * 100).toFixed(1) + '%' : '--');
            }

            if (elTot) elTot.textContent = pobNum.toLocaleString('es-MX');
            if (elMuj) elMuj.textContent = mujNum.toLocaleString('es-MX');
            if (elPctM) elPctM.textContent = pctM;
            if (elHom) elHom.textContent = homNum.toLocaleString('es-MX');
            if (elPctH) elPctH.textContent = pctH;

            if (chartPoblacionNacional) chartPoblacionNacional.destroy();
            const ctx = document.getElementById('canvasNacional');
            if (ctx) {
                var opts = crearOpcionesBarras('Habitantes');
                chartPoblacionNacional = new Chart(ctx.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: ['Total ' + nombreEstado, 'Mujeres', 'Hombres'],
                        datasets: [{
                            label: nombreEstado,
                            data: [pobNum, mujNum, homNum],
                            backgroundColor: ['#4a154b', '#c2185b', '#00897b'],
                            borderRadius: 8, borderWidth: 1, borderColor: '#ffffff', barPercentage: 0.65
                        }]
                    },
                    options: opts
                });
            }
        }

        function mostrarDatosMexicoNacional() {
            const titulo = document.getElementById('tituloPanelNacional');
            const subtitulo = document.getElementById('subtituloPanelNacional');
            const labelTotal = document.getElementById('labelNacionalTotal');
            const iconoWrapper = document.getElementById('iconoPanelNacional');
            const btnWrap = document.getElementById('btnVolverMexicoWrap');

            if (titulo) titulo.textContent = 'MÉXICO';
            if (subtitulo) subtitulo.textContent = 'Haz clic en un estado para ver sus datos';
            if (labelTotal) labelTotal.textContent = ' México';
            if (iconoWrapper) iconoWrapper.innerHTML = '<i class="fa-solid fa-earth-americas"></i>';
            if (btnWrap) btnWrap.style.display = 'none';

            if (estadoSeleccionado) {
                estadoSeleccionado.setStyle({ color:'#682260', weight:1.5, fillColor:'#f3e8f1', fillOpacity:0.25 });
                estadoSeleccionado = null;
            }

            actualizarKpisNacional();
            renderizarGraficaNacional();
        }

        function actualizarKpisEstatal() {
            if (!window.AdminDatos) return;
            const est = AdminDatos.getEstatal();
            const elTot = document.getElementById('kpiEstatalTotal');
            const elMuj = document.getElementById('kpiEstatalMujeres');
            const elPctM = document.getElementById('kpiEstatalPctMujeres');
            const elHom = document.getElementById('kpiEstatalHombres');
            const elPctH = document.getElementById('kpiEstatalPctHombres');

            if (elTot) elTot.textContent = est.pobFormateada;
            if (elMuj) elMuj.textContent = est.mujeresFormateada;
            if (elPctM) elPctM.textContent = est.pctMujeres + ' del total';
            if (elHom) elHom.textContent = est.hombresFormateada;
            if (elPctH) elPctH.textContent = est.pctHombres + ' del total';
        }

        function renderizarGraficaNacional() {
            actualizarKpisNacional();
            if (chartPoblacionNacional) chartPoblacionNacional.destroy();
            const ctxNacional = document.getElementById('canvasNacional').getContext('2d');
            const nac = AdminDatos.getNacional();
            const opts = crearOpcionesBarras('Millones de Habitantes');
            opts.plugins.tooltip.callbacks.label = function(c) {
                const nacCur = AdminDatos.getNacional();
                const val = Number(c.raw).toLocaleString('es-MX');
                let sub = '';
                if (c.dataIndex === 1) sub = ' (' + nacCur.pctMujeres + ')';
                if (c.dataIndex === 2) sub = ' (' + nacCur.pctHombres + ')';
                return ' ' + val + ' hab.' + sub;
            };
            chartPoblacionNacional = new Chart(ctxNacional, {
                type: 'bar',
                data: {
                    labels: ['Población Total', 'Mujeres en México', 'Hombres en México'],
                    datasets: [{
                        label: 'Habitantes',
                        data: [nac.pob, nac.mujeres, nac.hombres],
                        backgroundColor: ['#4a154b', '#c2185b', '#00897b'],
                        borderRadius: 8, borderWidth: 1, borderColor: '#ffffff', barPercentage: 0.65
                    }]
                },
                options: opts
            });
        }

        let modalEstatalBootstrap = null;
        let mapaEstatalLeaflet = null;
        let chartPoblacionEstatalModal = null;

        function abrirVentanaEstatal() {
            const modalEl = document.getElementById('modalEstatal');
            if (!modalEl) return;

            if (!modalEstatalBootstrap) {
                modalEstatalBootstrap = new bootstrap.Modal(modalEl);
                modalEl.addEventListener('shown.bs.modal', function () {
                    inicializarMapaEstatal();
                    renderizarGraficaEstatalModal();
                    if (mapaEstatalLeaflet) {
                        mapaEstatalLeaflet.closePopup();
                        mapaEstatalLeaflet.invalidateSize();
                    }
                });
                modalEl.addEventListener('hidden.bs.modal', function () {
                    if (mapaEstatalLeaflet) {
                        mapaEstatalLeaflet.closePopup();
                    }
                });
            } else {
                if (mapaEstatalLeaflet) {
                    mapaEstatalLeaflet.closePopup();
                }
            }
            modalEstatalBootstrap.show();
        }

        function inicializarMapaEstatal() {
            if (!mapaEstatalLeaflet) {
                mapaEstatalLeaflet = L.map('mapaEstatal').setView([17.0732, -96.7266], 7);
                configurarAutoCierrePopup(mapaEstatalLeaflet);

                L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
                    attribution: '&copy; Esri | INEGI Censo 2020',
                    maxZoom: 18
                }).addTo(mapaEstatalLeaflet);

                if (typeof geojsonEstadosMexico !== 'undefined') {
                    const featureOaxaca = geojsonEstadosMexico.features.filter(f => f.properties && f.properties.name && f.properties.name.toLowerCase().includes('oaxaca'));
                    if (featureOaxaca.length > 0) {
                        const capaOaxaca = L.geoJSON({ type: "FeatureCollection", features: featureOaxaca }, {
                            style: {
                                color: '#8e24aa',
                                weight: 4,
                                fillColor: '#ce93d8',
                                fillOpacity: 0.35
                            },
                            onEachFeature: function(feature, layer) {
                                layer.bindPopup(function() {
                                    return AdminDatos.generarHtmlPopupEstatal();
                                });
                            }
                        }).addTo(mapaEstatalLeaflet);

                        try {
                            mapaEstatalLeaflet.fitBounds(capaOaxaca.getBounds(), { padding: [15, 15] });
                        } catch(e) {}
                    }
                }
            } else {
                setTimeout(() => { mapaEstatalLeaflet.invalidateSize(); }, 200);
            }
        }

        function renderizarGraficaEstatalModal() {
            actualizarKpisEstatal();
            if (chartPoblacionEstatalModal) chartPoblacionEstatalModal.destroy();
            const ctxEstatal = document.getElementById('canvasEstatalModal').getContext('2d');
            const est = AdminDatos.getEstatal();
            const opts = crearOpcionesBarras('Millones de Habitantes');
            opts.plugins.tooltip.callbacks.label = function(c) {
                const estCur = AdminDatos.getEstatal();
                const val = Number(c.raw).toLocaleString('es-MX');
                let sub = '';
                if (c.dataIndex === 1) sub = ' (' + estCur.pctMujeres + ')';
                if (c.dataIndex === 2) sub = ' (' + estCur.pctHombres + ')';
                return ' ' + val + ' hab.' + sub;
            };
            chartPoblacionEstatalModal = new Chart(ctxEstatal, {
                type: 'bar',
                data: {
                    labels: ['Población Total Oaxaca', 'Mujeres en Oaxaca', 'Hombres en Oaxaca'],
                    datasets: [{
                        label: 'Habitantes',
                        data: [est.pob, est.mujeres, est.hombres],
                        backgroundColor: ['#4a154b', '#c2185b', '#00897b'],
                        borderRadius: 8, borderWidth: 1, borderColor: '#ffffff', barPercentage: 0.65
                    }]
                },
                options: opts
            });
        }

        if (window.AdminDatos) {
            AdminDatos.onCambio(function(tipo, detalle) {
                actualizarKpisNacional();
                actualizarKpisEstatal();

                const modalNacEl = document.getElementById('modalNacional');
                if (modalNacEl && modalNacEl.classList.contains('show')) {
                    renderizarGraficaNacional();
                }

                const modalEstEl = document.getElementById('modalEstatal');
                if (modalEstEl && modalEstEl.classList.contains('show')) {
                    renderizarGraficaEstatalModal();
                }
            });
        }

        document.addEventListener("show.bs.modal", function () {
            document.documentElement.style.overflow = "hidden";
        });
        document.addEventListener("shown.bs.modal", function () {
            document.querySelectorAll(".btn-territorial").forEach(btn => {
                btn.classList.remove("active");
                btn.blur();
            });
            document.querySelectorAll(".tema-card").forEach(card => {
                card.classList.remove("active");
                card.blur();
            });
        });
        document.addEventListener("hidden.bs.modal", function (event) {
            try {
                sessionStorage.removeItem('plataforma_vista_activa');
                if (event && event.target && event.target.id === 'modalAdmin') {
                    sessionStorage.removeItem('plataforma_admin_sesion_activa');
                    sessionStorage.removeItem('plataforma_admin_categoria');
                }
                if (window.location.hash) {
                    history.replaceState(null, document.title, window.location.pathname + window.location.search);
                }
            } catch(e) {}

            document.querySelectorAll(".btn-territorial").forEach(btn => {
                btn.classList.remove("active");
                btn.blur();
            });
            document.querySelectorAll(".tema-card").forEach(card => {
                card.classList.remove("active");
                card.blur();
            });
            if (!document.querySelector(".modal.show")) {
                document.documentElement.style.overflow = "";
            }
        });

        function restaurarVistaGuardada() {
            let vista = null;
            try {
                const guardada = sessionStorage.getItem('plataforma_vista_activa');
                if (guardada) vista = JSON.parse(guardada);
            } catch(e) {}

            const adminSesionActiva = sessionStorage.getItem('plataforma_admin_sesion_activa');
            const adminCat = sessionStorage.getItem('plataforma_admin_categoria') || 'inicio';

            const hash = window.location.hash;
            if (hash === '#admin') {
                if (window.AdminDatosUI) {
                    AdminDatosUI.solicitarAccesoAdmin();
                }
                return;
            }
            if (adminSesionActiva === 'true') {
                const modalAdminEl = document.getElementById('modalAdmin');
                if (modalAdminEl && window.bootstrap && bootstrap.Modal) {
                    const modalAdminInst = bootstrap.Modal.getOrCreateInstance(modalAdminEl);
                    modalAdminInst.show();
                    if (window.AdminMenuDashboard) {
                        AdminMenuDashboard.seleccionar(adminCat);
                    }
                }
                return;
            }

            if (hash) {
                if (hash === '#nacional') vista = { tipo: 'territorial', id: 'NACIONAL' };
                else if (hash === '#estatal') vista = { tipo: 'territorial', id: 'ESTATAL' };
                else if (hash.startsWith('#tema-')) {
                    vista = { tipo: 'tema', id: hash.replace('#tema-', '') };
                }
            }

            if (vista) {
                if (vista.tipo === 'territorial') {
                    const btn = document.getElementById(vista.id === 'NACIONAL' ? 'btnNacional' : 'btnEstatal');
                    cambiarAmbito(vista.id, btn);
                } else if (vista.tipo === 'tema') {
                    const card = document.querySelector(`.tema-card[onclick*="'${vista.id}'"]`);
                    if (typeof mostrarTema === 'function') {
                        mostrarTema(vista.id, card);
                    }
                }
            }
        }



        document.addEventListener('DOMContentLoaded', function() {
            actualizarKpisNacional();
            actualizarKpisEstatal();

            restaurarVistaGuardada();
            requestAnimationFrame(function() {
                setTimeout(function() {
                    document.documentElement.classList.remove('recarga-modal-activa');
                }, 100);
            });
        });
    </script>
<!-- SCRIPT OPTIMIZADO PARA GENERAR LAS TARJETAS MINI EN EL FOOTER -->
<script>
    const DIMENSIONES = [
        { id: 'atendidas',    nombre: 'Atendidas',    icono: 'fa-people-group',       color: 'tema-atendidas' },
        { id: 'psicologia',   nombre: 'Psicología',   icono: 'fa-hand-holding-heart', color: 'tema-psicologia' },
        { id: 'juicios',      nombre: 'Juicios',      icono: 'fa-scale-balanced',     color: 'tema-legal' },
        { id: 'feminicidios', nombre: 'Feminicidios', icono: 'fa-ribbon',             color: 'tema-feminicidios' },
        { id: 'talleres',     nombre: 'Talleres',     icono: 'fa-chalkboard-user',    color: 'tema-talleres' },
        { id: 'proyectos',    nombre: 'Proyectos',    icono: 'fa-diagram-project',    color: 'tema-proyectos' },
        { id: 'salud',        nombre: 'Salud',        icono: 'fa-heart-pulse',        color: 'tema-salud' },
        { id: 'educacion',    nombre: 'Educación',    icono: 'fa-book-open',          color: 'tema-educacion' },
        { id: 'vivienda',     nombre: 'Vivienda',     icono: 'fa-house-chimney',      color: 'tema-vivienda' },
        { id: 'ingreso',      nombre: 'Ingreso',      icono: 'fa-sack-dollar',        color: 'tema-ingreso' },
        { id: 'lenguas',      nombre: 'Lenguas',      icono: 'fa-language',           color: 'tema-lenguas' }
    ];

    let timerTarjetaMiniActiva = null;

    function crearTarjetaMini(dim) {
        return `
            <div class="tema-card-mini"
                 data-dim="${dim.id}"
                 onclick="seleccionarTarjetaMini('${dim.id}', this)"
                 title="${dim.nombre}">
                <div class="tema-icon-wrapper ${dim.color}">
                    <i class="fa-solid ${dim.icono}"></i>
                </div>
                <span class="tema-nombre-mini">${dim.nombre}</span>
            </div>
        `;
    }

    function renderizarTarjetasFooter() {
        const contenedores = document.querySelectorAll('#contenedorTarjetasModal');
        contenedores.forEach(contenedor => {
            contenedor.innerHTML = DIMENSIONES.map(d => crearTarjetaMini(d)).join('');
        });
    }

    function seleccionarTarjetaMini(idDim, elemento) {
        document.querySelectorAll('.tema-card-mini').forEach(t => t.classList.remove('active'));

        if (elemento) {
            elemento.classList.add('active');

            if (timerTarjetaMiniActiva) clearTimeout(timerTarjetaMiniActiva);
            timerTarjetaMiniActiva = setTimeout(function () {
                if (elemento) {
                    elemento.classList.remove('active');
                    elemento.blur();
                }
            }, 1600);
        }

        if (typeof mostrarTema === 'function') {
            mostrarTema(idDim, null);
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        renderizarTarjetasFooter();

        const modalTematicoEl = document.getElementById('modalTematico');
        if (modalTematicoEl) {
            modalTematicoEl.addEventListener('shown.bs.modal', function() {
                renderizarTarjetasFooter();
            });
        }
    });
</script>
</body>
</html>